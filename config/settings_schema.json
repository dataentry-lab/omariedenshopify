[
  {
    "name": "theme_info",
    "theme_name": "Omarieden",
    "theme_version": "1.0.0",
    "theme_author": "Omarieden",
    "theme_documentation_url": "https://omarieden.com",
    "theme_support_url": "https://omarieden.com/contact-us"
  },
  {
    "name": "Navigation",
    "settings": [
      {
        "type": "link_list",
        "id": "main_menu",
        "label": "Main menu",
        "info": "3 levels: department (Women) > sub-department (CLOTHING) > category (Dresses). Used by the desktop nav, mega menu, mobile menu and the filter drawer category tree.",
        "default": "main-menu"
      }
    ]
  },
  {
    "name": "Products",
    "settings": [
      {
        "type": "text",
        "id": "color_option_name",
        "label": "Colour option name",
        "default": "Color",
        "info": "The product option used for colour swatches."
      },
      {
        "type": "text",
        "id": "size_option_name",
        "label": "Size option name",
        "default": "Size"
      },
      {
        "type": "textarea",
        "id": "color_swatch_map",
        "label": "Colour swatch map",
        "info": "One per line: COLOUR NAME:#hex. Two or three colours split the circle: NAVY WHITE:#1f2a44,#ffffff. Shopify's own swatches (colour or image, linked Color option) win when set.",
        "default": "BLACK:#313131\nWHITE:#ffffff\nBROWN:#a37146\nRAISIN:#a37146\nHAZEBLUE:#679ad1\nBLUESTRIPE:#679ad1\nBARK:#a37146\nOATMEAL:#f0e8d6\nPIERRE:#f0e8d6\nCHALK:#ffffff\nGREIGE:#bbbbbb\nNAVY:#1f2a44\nRED:#bc2027\nGREEN:#595b33\nBEIGE:#e5d9c7\nPINK:#e8b4c0\nYELLOW:#e6c34a\nGREY:#9a9a9a\nGRAY:#9a9a9a"
      },
      {
        "type": "select",
        "id": "gallery_color_mode",
        "label": "Product gallery and colours",
        "options": [
          {
            "value": "filter",
            "label": "Show only the selected colour's photos"
          },
          {
            "value": "sync",
            "label": "All photos, swatch follows the gallery"
          },
          {
            "value": "off",
            "label": "Off (all photos, jump to the colour's photo)"
          }
        ],
        "default": "filter",
        "info": "A photo belongs to a colour when it is the variant image of that colour, or its alt text is the colour name (optionally followed by \" - description\"). Photos without a colour show for every colour."
      },
      {
        "type": "number",
        "id": "return_days",
        "label": "Return period shown on product page (days)",
        "default": 30
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold (SAR)",
        "default": 500
      },
      {
        "type": "text",
        "id": "style_code_metafield",
        "label": "Style code metafield (namespace.key)",
        "default": "custom.style_code",
        "info": "Optional. Shown as 'Style Code' on the product page. Falls back to the variant SKU."
      },
      {
        "type": "text",
        "id": "material_metafield",
        "label": "Material composition metafield (namespace.key)",
        "default": "custom.material"
      },
      {
        "type": "text",
        "id": "care_metafield",
        "label": "Details & care metafield (namespace.key)",
        "default": "custom.care"
      },
      {
        "type": "collection",
        "id": "trending_collection",
        "label": "Trending collection",
        "info": "Used for 'Trending now' on the cart page and as fallback for related products."
      },
      {
        "type": "collection",
        "id": "related_fallback_collection",
        "label": "'You might also like' fallback collection"
      }
    ]
  },
  {
    "name": "Product badges",
    "settings": [
      {
        "type": "paragraph",
        "content": "Badges follow the product everywhere (collection, search, sliders, wishlist, cart, quick view, product page). Rules are checked top to bottom, first matches win, maximum two badges per card. Sold out always replaces the others."
