  {
    "name": "Collections",
    "settings": [
      {
        "type": "range",
        "id": "products_per_page",
        "label": "Products per page",
        "min": 12,
        "max": 48,
        "step": 6,
        "default": 24
      }
    ]
  },
  {
    "name": "Texts",
    "settings": [
      {
        "type": "text",
        "id": "circle_text",
        "label": "OMARIEDEN Circle card text",
        "default": "A new way to belong is on its way. The OMARIEDEN Circle, arriving soon."
      }
    ]
  },
  {
    "name": "Tracking & scripts",
    "settings": [
      {
        "type": "html",
        "id": "head_verification",
        "label": "Head scripts / verification tags",
        "info": "Pasted into <head>: Google site verification, Facebook domain verification, GTM head snippet, MoEngage, Clarity. (Prefer the Shopify Google & YouTube / Facebook channel apps where possible.)"
      },
      {
        "type": "html",
        "id": "body_start_scripts",
        "label": "Body start scripts",
        "info": "e.g. the GTM <noscript> iframe."
      }
    ]
  },
  {
    "name": "Events",
    "settings": [
      {
        "type": "paragraph",
        "content": "Events are products with the product type \"Event\", in the collection below (keep it out of the menu). Ticket types are the variants (price 0 = free, inventory = seats). Event details are product fields (custom.event_start, event_end, venue, address, map_url, duration, short_description, details, attendee_fields, sessions, gallery, banner_video). Give each event the product template \"event\"."
      },
      {
        "type": "collection",
        "id": "events_collection",
        "label": "Events collection"
      },
      {
        "type": "page",
        "id": "events_page",
        "label": "Events listing page (page template \"events\")"
      },
      {
        "type": "range",
        "id": "event_soon_days",
        "label": "\"n days left\" tag within",
        "min": 1,
        "max": 30,
        "step": 1,
        "unit": "d",
        "default": 7
      },
      {
        "type": "range",
        "id": "event_fast_threshold",
        "label": "\"Selling fast\" when seats left are at most",
        "min": 1,
        "max": 50,
        "step": 1,
        "default": 10
      },
      {
        "type": "range",
        "id": "events_tz_offset",
        "label": "Time zone offset from UTC",
        "min": -12,
        "max": 14,
        "step": 1,
        "unit": "h",
        "default": 3,
        "info": "Riyadh = 3. Event times are shifted by this many hours."
      },
      {
        "type": "text",
        "id": "event_terms_url",
        "label": "Event terms page link (booking checkbox)"
      }
    ]
  }
