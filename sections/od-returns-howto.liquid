{%- comment -%}
  Returns & Refunds page (28 Oct 2026): "How to request a return" = one centred column, numbered steps (circled number,
  title, one line) separated by hairlines, then a sandstone "Start a return" box (order number + email + button).
  The form sends the customer to sign in (one-time code) and on to the hosted account page where every order has its
  Request return button; the order number is kept in sessionStorage only. Steps are blocks (EN + *_ar). CSS: od-blocks.css (.od-rhow).
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign rtl = false
  if request.locale.iso_code contains 'ar'
    assign rtl = true
  endif
  assign eyebrow = st.eyebrow
  assign heading = st.heading
  assign box_label = st.box_label
  assign l_order = st.label_order
  assign l_email = st.label_email
  assign l_btn = st.button_label
  assign note = st.note
  if rtl
    assign eyebrow = st.eyebrow_ar | default: eyebrow
    assign heading = st.heading_ar | default: heading
    assign box_label = st.box_label_ar | default: box_label
    assign l_order = st.label_order_ar | default: l_order
    assign l_email = st.label_email_ar | default: l_email
    assign l_btn = st.button_label_ar | default: l_btn
    assign note = st.note_ar | default: note
  endif
  assign return_to = st.return_to | default: routes.account_url
  assign login_url = routes.account_login_url
  if login_url contains '?'
    assign login_url = login_url | append: '&return_to=' | append: return_to
  else
    assign login_url = login_url | append: '?return_to=' | append: return_to
  endif
  if customer
    assign login_url = return_to
  endif
-%}
<section class="od-blk od-rhow" id="od-rhow-{{ section.id }}" style="--od-blk-bg: {{ st.bg | default: 'transparent' }}; --od-blk-text: {{ st.text_color }}; --od-rhow-box: {{ st.box_bg }}; --od-rtn-btn: {{ st.button_color }}; --od-rtn-btn-text: {{ st.button_text_color }}; padding-top: {{ st.pad_top }}px; padding-bottom: {{ st.pad_bottom }}px;">
  <div class="_container_1kxnl_30">
    <div class="od-rhow__col">
      {%- if eyebrow != blank -%}<p class="od-blk__eyebrow od-rhow__eyebrow">{{ eyebrow }}</p>{%- endif -%}
      {%- if heading != blank -%}<h2 class="od-blk__heading od-rhow__heading">{{ heading }}</h2>{%- endif -%}
      <ol class="od-rhow__steps">
        {%- for block in section.blocks -%}
          {%- liquid
            assign t = block.settings.title
            assign d = block.settings.text
            if rtl
              assign t = block.settings.title_ar | default: t
              assign d = block.settings.text_ar | default: d
            endif
          -%}
          <li class="od-rhow__step" {{ block.shopify_attributes }}>
            <span class="od-rhow__num" aria-hidden="true">{{ forloop.index }}</span>
            <div class="od-rhow__body">
              {%- if t != blank -%}<p class="od-rhow__title">{{ t }}</p>{%- endif -%}
              {%- if d != blank -%}<p class="od-rhow__text">{{ d }}</p>{%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
      {%- if st.show_form -%}
        <div class="od-rhow__box">
          {%- if box_label != blank -%}<p class="od-blk__eyebrow od-rhow__boxlabel">{{ box_label }}</p>{%- endif -%}
          <form class="od-rhow__form" action="{{ login_url }}" method="get" data-returns-form data-go="{{ login_url | escape }}">
            <label class="od-rhow__field"><span class="visually-hidden">{{ l_order }}</span><input type="text" name="order" inputmode="numeric" autocomplete="off" placeholder="{{ l_order | escape }}" data-returns-order></label>
            <label class="od-rhow__field"><span class="visually-hidden">{{ l_email }}</span><input type="email" name="email" autocomplete="email" placeholder="{{ l_email | escape }}"></label>
            <button type="submit" class="od-blk__btn od-blk__btn--solid od-rhow__btn">{{ l_btn }}</button>
          </form>
          {%- if note != blank -%}<p class="od-rhow__note">{{ note }}</p>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
<script>
  (function () {
    var f = document.querySelector('#od-rhow-{{ section.id }} [data-returns-form]');
    if (!f) return;
    f.addEventListener('submit', function (e) {
      e.preventDefault();
      var n = f.querySelector('[data-returns-order]');
      try { if (n && n.value) sessionStorage.setItem('od_return_order', n.value.trim()); } catch (err) {}
      location.href = f.getAttribute('data-go');
    });
  })();
</script>

{% schema %}
{
  "name": "Returns: how to",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Returns" },
    { "type": "text", "id": "eyebrow_ar", "label": "Eyebrow (Arabic)", "default": "الإرجاع" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How to request a return" },
    { "type": "text", "id": "heading_ar", "label": "Heading (Arabic)", "default": "كيف تطلب الإرجاع" },
    { "type": "header", "content": "Start a return box" },
    { "type": "checkbox", "id": "show_form", "label": "Show the form box under the steps", "default": true },
    { "type": "text", "id": "box_label", "label": "Box label", "default": "Start a return" },
    { "type": "text", "id": "box_label_ar", "label": "Box label (Arabic)", "default": "ابدأ الإرجاع" },
    { "type": "text", "id": "label_order", "label": "Order number placeholder", "default": "Order number" },
    { "type": "text", "id": "label_order_ar", "label": "Order number placeholder (Arabic)", "default": "رقم الطلب" },
    { "type": "text", "id": "label_email", "label": "Email placeholder", "default": "Email" },
    { "type": "text", "id": "label_email_ar", "label": "Email placeholder (Arabic)", "default": "البريد الإلكتروني" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Start" },
    { "type": "text", "id": "button_label_ar", "label": "Button (Arabic)", "default": "ابدأ" },
    { "type": "text", "id": "note", "label": "Line under the form (optional)" },
    { "type": "text", "id": "note_ar", "label": "Line under the form (Arabic)" },
    { "type": "text", "id": "return_to", "label": "After sign-in, open", "info": "Empty = the Shopify account page with the orders and their Request return button." },
    { "type": "header", "content": "Colours and spacing" },
    { "type": "color", "id": "bg", "label": "Background" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#551c25" },
    { "type": "color", "id": "box_bg", "label": "Form box background", "default": "#f3ede3" },
    { "type": "color", "id": "button_color", "label": "Button", "default": "#595b33" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#ffffff" },
    { "type": "range", "id": "pad_top", "label": "Space above", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "pad_bottom", "label": "Space below", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "title_ar", "label": "Title (Arabic)" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "text", "id": "text_ar", "label": "Text (Arabic)" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Returns: how to",
      "blocks": [
        { "type": "step", "settings": { "title": "Sign in to your account", "title_ar": "سجّل الدخول إلى حسابك", "text": "Open Orders and choose the order with the item you want to send back.", "text_ar": "افتح الطلبات واختر الطلب الذي يحتوي على القطعة التي تريد إرجاعها." } },
        { "type": "step", "settings": { "title": "Tap Request return", "title_ar": "اضغط طلب إرجاع", "text": "Select the items and a reason, within 30 days of delivery.", "text_ar": "اختر القطع والسبب، خلال 30 يوماً من التوصيل." } },
        { "type": "step", "settings": { "title": "We collect it, or bring it in", "title_ar": "نستلمها منك، أو أحضرها إلى المتجر", "text": "Pack it in the original packaging with all tags, boxes and dust bags; the courier collects it, or visit the store with your order number.", "text_ar": "ضعها في التغليف الأصلي مع كل البطاقات والعلب والأكياس؛ يستلمها المندوب، أو زر المتجر مع رقم طلبك." } },
        { "type": "step", "settings": { "title": "Refund within 6 working days", "title_ar": "الاسترداد خلال 6 أيام عمل", "text": "Processed once the item reaches us, to the original payment method or store credit.", "text_ar": "يُعالج بعد وصول القطعة إلينا، إلى وسيلة الدفع الأصلية أو كرصيد في المتجر." } }
      ]
    }
  ]
}
{% endschema %}
