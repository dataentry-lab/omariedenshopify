{%- capture od_locked -%}{%- render 'prive-locked' -%}{%- endcapture -%}
{%- unless od_locked contains 'yes' -%}
{%- comment -%}
  "Just Arrived" (Net-a-Porter Live animation): a row of the newest products; every few seconds a new card slides in
  from the start, the row shifts, the last card slides out. Also used as "Privé Live" (source = hand-picked products,
  dark colours) on the Privé page. Behaviour: assets/od-home.js, styles: assets/od-home.css.
{%- endcomment -%}
{%- liquid
  assign rtl = false
  if request.locale.iso_code contains 'ar'
    assign rtl = true
  endif
  assign st = section.settings
  assign limit = st.limit | default: 12
  assign products = blank
  if st.source == 'products' and st.products != blank
    assign products = st.products
  elsif st.collection != blank
    assign products = collections[st.collection].products
  else
    assign products = collections.all.products
  endif
  assign now_s = 'now' | date: '%s' | plus: 0
  assign week_ago = now_s | minus: 604800
  assign fresh = 0
  for p in products limit: 50
    assign pub = p.published_at | date: '%s' | plus: 0
    if pub > week_ago
      assign fresh = fresh | plus: 1
    endif
  endfor
  assign count_text = st.count_text | replace: '[count]', fresh
-%}
{{ 'od-home.css' | asset_url | stylesheet_tag }}
<section class="od-live{% if st.dark %} od-live--dark{% endif %}" id="od-live-{{ section.id }}" data-od-live data-speed="{{ st.speed | default: 3 }}" data-visible="{{ st.visible | default: 6 }}" data-visible-mobile="{{ st.visible_mobile | default: 2.5 }}"
  style="--od-live-bg: {{ st.bg }}; --od-live-text: {{ st.text_color }}; --od-live-accent: {{ st.accent }}; --od-live-card-bg: {{ st.card_bg }};">
  <div class="_container_1kxnl_30 od-live__inner">
    <header class="od-live__head">
      <h2 class="od-live__title">{{ st.heading }}{% if st.heading_italic != blank %} <em>{{ st.heading_italic }}</em>{% endif %}</h2>
      {%- if st.show_count and count_text != blank -%}
        <p class="od-live__count"><span class="od-live__dot" aria-hidden="true"></span>{{ count_text }}</p>
      {%- endif -%}
      {%- if st.tagline != blank -%}<p class="od-live__tagline">{{ st.tagline }}</p>{%- endif -%}
    </header>
    <div class="od-live__viewport" data-od-live-viewport>
      <div class="od-live__row" data-od-live-row>
        {%- for product in products limit: limit -%}
          {%- assign img = product.featured_image -%}
          <div class="od-live__card od-card{% if rtl %} od-card--rtl{% endif %}" data-od-card data-product-card data-handle="{{ product.handle }}" data-product-id="{{ product.id }}">
            <div class="od-card__media od-live__media">
              <a href="{{ product.url }}" class="od-card__link" aria-label="{{ product.title | escape }}">
                {%- if img -%}
                  <img class="od-card__img" alt="{{ img.alt | default: product.title | escape }}" src="{{ img | image_url: width: 500 }}" width="{{ img.width }}" height="{{ img.height }}" loading="lazy" data-card-image>
                {%- else -%}
                  <img class="od-card__img" alt="" src="{{ 'images_fallback.svg' | asset_url }}" width="500" height="750" data-card-image>
                {%- endif -%}
              </a>
              <div class="od-card__top">
                <div class="od-card__top-start"></div>
                <div class="od-card__top-end">
                  <div class="_globalImg_1tf1q_38 _wishlistIcon_13l1w_356 od-card__wish" data-wishlist-toggle data-wishlist-id="{{ product.id }}" data-wishlist-handle="{{ product.handle }}" role="button" tabindex="0" aria-label="{{ 'wishlist.add' | t }}"><img alt="" width="24" height="24" src="{{ 'icons_light_wishlist.svg' | asset_url }}"></div>
                </div>
              </div>
              {%- if product.available -%}
                <button type="button" class="od-card__plus" data-card-quickadd aria-label="{{ 'products.card.quick_add' | t }}" aria-haspopup="dialog">{%- render 'icon-bag-plus' -%}</button>
              {%- endif -%}
            </div>
            <div class="od-live__text">
              {%- if product.vendor != blank -%}<p class="od-live__brand">{{ product.vendor }}</p>{%- endif -%}
              <p class="od-live__name"><a href="{{ product.url }}">{{ product.title }}</a></p>
              {%- case st.caption -%}
                {%- when 'text' -%}<p class="od-live__caption">{{ st.caption_text }}</p>
                {%- when 'price' -%}<p class="od-live__caption od-live__caption--price">{% render 'sar' %}{{ product.price | money_without_currency }}</p>
              {%- endcase -%}
            </div>
            {%- render 'product-json', product: product -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
<script src="{{ 'od-home.js' | asset_url }}" defer></script>
{%- endunless -%}

{% schema %}
{
  "name": "Just Arrived (live)",
  "tag": "section",
  "class": "od-live-section",
  "settings": [
    { "type": "paragraph", "content": "Newest products in a live row: a new card slides in every few seconds (Net-a-Porter Live). Cards have the heart and the quick-view button." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "OMARIEDEN" },
    { "type": "text", "id": "heading_italic", "label": "Heading, italic part", "default": "Just Arrived" },
    { "type": "checkbox", "id": "show_count", "label": "Show the \"new this week\" line", "default": true },
    { "type": "text", "id": "count_text", "label": "New this week text", "info": "[count] is replaced by the number of products published in the last 7 days", "default": "[count] new pieces this week" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "The latest arrivals, as they land in store" },
    { "type": "header", "content": "Products" },
    { "type": "select", "id": "source", "label": "Source", "default": "collection", "options": [ { "value": "collection", "label": "Collection (newest first)" }, { "value": "products", "label": "Hand-picked products" } ] },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty for all products. Sort the collection by newest first in Shopify." },
    { "type": "product_list", "id": "products", "label": "Hand-picked products", "limit": 24 },
    { "type": "range", "id": "limit", "label": "Products in the row", "min": 6, "max": 24, "step": 1, "default": 12 },
    { "type": "header", "content": "Animation" },
    { "type": "range", "id": "visible", "label": "Cards visible (desktop)", "min": 3, "max": 8, "step": 1, "default": 6 },
    { "type": "range", "id": "visible_mobile", "label": "Cards visible (mobile)", "min": 1.5, "max": 3.5, "step": 0.5, "default": 2.5 },
    { "type": "range", "id": "speed", "label": "New card every", "min": 1, "max": 8, "step": 1, "unit": "s", "default": 3 },
    { "type": "select", "id": "caption", "label": "Third line on the card", "default": "text", "options": [ { "value": "text", "label": "Caption text" }, { "value": "price", "label": "Price" }, { "value": "none", "label": "Nothing" } ] },
    { "type": "text", "id": "caption_text", "label": "Caption text", "default": "Just arrived" },
    { "type": "header", "content": "Colours" },
    { "type": "checkbox", "id": "dark", "label": "Dark style (Privé)", "default": false },
    { "type": "color", "id": "bg", "label": "Background", "default": "#fcf8f2" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#551c25" },
    { "type": "color", "id": "accent", "label": "Accent (pulsing dot, caption)", "default": "#595b33" },
    { "type": "color", "id": "card_bg", "label": "Image background", "default": "#f1eeea" }
  ],
  "presets": [
    { "name": "Just Arrived (live)" },
    { "name": "Privé Live", "settings": { "heading": "OMARIEDEN", "heading_italic": "Privé Live", "source": "products", "dark": true, "bg": "#2a0d12", "text_color": "#fcf8f2", "accent": "#c9a96a", "card_bg": "#3a171e", "count_text": "", "tagline": "Reserved for Privé members" } }
  ]
}
{% endschema %}
