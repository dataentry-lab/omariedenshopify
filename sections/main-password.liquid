{%- comment -%}
  Coming Soon page (layout/password.liquid). Blurred store photo + dark maroon overlay, two emblems at the edges
  (one at the bottom on mobile) turning slowly, logo, "Coming Soon", text, GET NOTIFIED (popup: email + optional phone,
  saves the customer with a tag, phone emailed to the store), "Enter with password" link at the bottom opens the password form.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign bg = st.bg_image
  assign logo = st.logo
  assign emblem = st.emblem
  assign rtl = false
  if request.locale.iso_code contains 'ar'
    assign rtl = true
  endif
  if rtl
    assign t_heading = st.heading_ar | default: st.heading
    assign t_text = st.text_ar | default: st.text
    assign t_button = st.button_label_ar | default: st.button_label
    assign t_nheading = st.notify_heading_ar | default: st.notify_heading
    assign t_ntext = st.notify_text_ar | default: st.notify_text
    assign t_email = st.label_email_ar | default: st.label_email
    assign t_phone = st.label_phone_ar | default: st.label_phone
    assign t_sheading = st.success_heading_ar | default: st.success_heading
    assign t_stext = st.success_text_ar | default: st.success_text
  else
    assign t_heading = st.heading
    assign t_text = st.text
    assign t_button = st.button_label
    assign t_nheading = st.notify_heading
    assign t_ntext = st.notify_text
    assign t_email = st.label_email
    assign t_phone = st.label_phone
    assign t_sheading = st.success_heading
    assign t_stext = st.success_text
  endif
-%}
<main class="od-pw" data-od-password style="--od-pw-overlay: {{ st.overlay_color }}; --od-pw-overlay-a: {{ st.overlay_opacity | divided_by: 100.0 }}; --od-pw-blur: {{ st.blur }}px; --od-pw-ink: {{ st.text_color }}; --od-pw-speed: {{ st.spin }}s;">
  <div class="od-pw__bg" aria-hidden="true">
    {%- if bg != blank -%}
      <img src="{{ bg | image_url: width: 2400 }}" srcset="{{ bg | image_url: width: 1200 }} 1200w, {{ bg | image_url: width: 2400 }} 2400w" sizes="100vw" alt="" width="{{ bg.width }}" height="{{ bg.height }}">
    {%- else -%}
      <img src="{{ 'images_coming-soon-bg.jpg' | asset_url }}" alt="">
    {%- endif -%}
    <div class="od-pw__overlay"></div>
  </div>
  {%- if st.show_lang and shop.published_locales.size > 1 -%}
    <nav class="od-pw__lang" aria-label="Language">
      {%- for loc in shop.published_locales -%}
        {%- unless loc.iso_code == request.locale.iso_code -%}
          <a href="{{ loc.root_url }}" lang="{{ loc.iso_code }}" hreflang="{{ loc.iso_code }}">{% if loc.iso_code contains 'ar' %}العربية{% else %}{{ loc.endonym_name | default: loc.name }}{% endif %}</a>
        {%- endunless -%}
      {%- endfor -%}
    </nav>
  {%- endif -%}
  {%- capture emblem_src -%}{% if emblem != blank %}{{ emblem | image_url: width: 1000 }}{% else %}{{ 'images_coming-soon-emblem.png' | asset_url }}{% endif %}{%- endcapture -%}
  {%- if st.show_emblems -%}
    <img class="od-pw__emblem od-pw__emblem--l" src="{{ emblem_src }}" alt="" aria-hidden="true" loading="lazy">
    <img class="od-pw__emblem od-pw__emblem--r" src="{{ emblem_src }}" alt="" aria-hidden="true" loading="lazy">
  {%- endif -%}

  <div class="od-pw__content">
    <div class="od-pw__logo">
      {%- if logo != blank -%}<img src="{{ logo | image_url: width: 800 }}" alt="{{ shop.name | escape }}" width="{{ logo.width }}" height="{{ logo.height }}">
      {%- else -%}<img src="{{ 'images_coming-soon-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="861" height="440">{%- endif -%}
    </div>
    <h1 class="od-pw__title">{{ t_heading | default: 'Coming Soon' }}</h1>
    {%- if t_text != blank -%}<div class="od-pw__text">{{ t_text }}</div>{%- endif -%}
    <button type="button" class="od-pw__btn" data-pw-open="notify">{{ t_button | default: 'Get notified' }}</button>
  </div>

  <div class="od-pw__foot">
    {%- if st.show_social -%}
      <div class="od-pw__social">
        {%- if st.instagram != blank -%}<a href="{{ st.instagram }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
        {%- if st.tiktok != blank -%}<a href="{{ st.tiktok }}" target="_blank" rel="noopener">TikTok</a>{%- endif -%}
        {%- if st.whatsapp != blank -%}<a href="{{ st.whatsapp }}" target="_blank" rel="noopener">WhatsApp</a>{%- endif -%}
      </div>
    {%- endif -%}
    <button type="button" class="od-pw__link" data-pw-open="password">{{ 'password.enter_with_password' | t }}</button>
    <p class="od-pw__copy">&copy; {{ shop.name }} {{ 'now' | date: '%Y' }}</p>
  </div>

  {%- comment -%} popups {%- endcomment -%}
  <div class="od-pw__modal" data-pw-modal="notify" hidden>
    <div class="od-pw__backdrop" data-pw-close></div>
    <div class="od-pw__panel" role="dialog" aria-modal="true" aria-labelledby="od-pw-notify-title">
      <button type="button" class="od-pw__x" data-pw-close aria-label="{{ 'general.accessibility.close' | t }}">&times;</button>
      <div class="od-pw__panel-in" data-pw-step="form">
        <h2 class="od-pw__ptitle" id="od-pw-notify-title">{{ t_nheading | default: 'Get Notified' }}</h2>
        {%- if t_ntext != blank -%}<p class="od-pw__ptext">{{ t_ntext }}</p>{%- endif -%}
        {%- form 'customer', class: 'od-pw__form', data-pw-form: 'notify' -%}
          <input type="hidden" name="contact[tags]" value="{{ st.customer_tag | default: 'coming-soon' | escape }}">
          <input type="hidden" name="contact[accepts_marketing]" value="true">
          <label class="od-pw__field"><span>{{ t_email | default: 'Email Address' }}</span><input type="email" name="contact[email]" required autocomplete="email" placeholder="{{ st.email_placeholder | default: 'you@example.com' | escape }}"></label>
          <label class="od-pw__field"><span>{{ t_phone | default: 'Phone Number (Optional)' }}</span><input type="tel" name="phone" autocomplete="tel" placeholder="+966 5x xxx xxxx" data-pw-phone></label>
          <button type="submit" class="od-pw__btn od-pw__btn--solid">{{ t_button | default: 'Get notified' }}</button>
          <p class="od-pw__err" data-pw-error hidden></p>
        {%- endform -%}
        {%- comment -%} phone goes to the store inbox through a contact form, sent by JS when filled {%- endcomment -%}
        {%- form 'contact', class: 'od-pw__hidden', data-pw-form: 'phone' -%}
          <input type="hidden" name="contact[form]" value="Coming soon: get notified">
          <input type="hidden" name="contact[email]" value="" data-pw-phone-email>
          <input type="hidden" name="contact[phone]" value="" data-pw-phone-copy>
          <input type="hidden" name="contact[body]" value="Wants to be notified when Omarieden opens." >
        {%- endform -%}
      </div>
      <div class="od-pw__panel-in od-pw__done" data-pw-step="done" hidden>
        <h2 class="od-pw__ptitle">{{ t_sheading | default: "You're on the list" }}</h2>
        <p class="od-pw__ptext">{{ t_stext | default: 'We will write the moment the doors open.' }}</p>
        <button type="button" class="od-pw__btn" data-pw-close>{{ 'general.accessibility.close' | t }}</button>
      </div>
    </div>
  </div>

  <div class="od-pw__modal" data-pw-modal="password" hidden>
    <div class="od-pw__backdrop" data-pw-close></div>
    <div class="od-pw__panel" role="dialog" aria-modal="true" aria-labelledby="od-pw-pass-title">
      <button type="button" class="od-pw__x" data-pw-close aria-label="{{ 'general.accessibility.close' | t }}">&times;</button>
      <div class="od-pw__panel-in">
        <h2 class="od-pw__ptitle" id="od-pw-pass-title">{{ 'password.enter_password' | t }}</h2>
        {%- form 'storefront_password', class: 'od-pw__form' -%}
          <label class="od-pw__field"><span>{{ 'password.password' | t }}</span><input type="password" name="password" required autocomplete="current-password" {% if form.errors %}autofocus{% endif %}></label>
          {%- if form.errors -%}<p class="od-pw__err" data-pw-wrong>{{ 'password.wrong' | t }}</p>{%- endif -%}
          <button type="submit" class="od-pw__btn od-pw__btn--solid">{{ 'password.enter' | t }}</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</main>

{% schema %}
{
  "name": "Coming Soon",
  "settings": [
    { "type": "image_picker", "id": "bg_image", "label": "Background photo", "info": "Empty = the store photo supplied (DSC00594)." },
    { "type": "range", "id": "blur", "label": "Photo blur", "min": 0, "max": 20, "step": 1, "unit": "px", "default": 6 },
    { "type": "color", "id": "overlay_color", "label": "Overlay colour", "default": "#2a0d12" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 60 },
    { "type": "image_picker", "id": "logo", "label": "Logo (Arabic + wordmark)", "info": "Empty = the cream logo supplied." },
    { "type": "image_picker", "id": "emblem", "label": "Emblem", "info": "Empty = the sand emblem supplied." },
    { "type": "checkbox", "id": "show_emblems", "label": "Show the emblems", "default": true },
    { "type": "range", "id": "spin", "label": "Emblem rotation (seconds per turn)", "min": 20, "max": 240, "step": 10, "unit": "s", "default": 120 },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#e5d9c7" },
    { "type": "header", "content": "Text" },
    { "type": "checkbox", "id": "show_lang", "label": "Show the language switch", "default": true },
    { "type": "header", "content": "Text (English)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The store is currently undergoing maintenance" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>To make your shopping experience easier and more enjoyable. We will be back soon.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get notified" },
    { "type": "header", "content": "Text (Arabic)" },
    { "type": "text", "id": "heading_ar", "label": "Heading", "default": "المتجر حاليًا تحت الصيانة" },
    { "type": "richtext", "id": "text_ar", "label": "Text", "default": "<p>عشان تجربة تسوقكم تكون أسهل وأحلى. راجعين لكم قريب</p>" },
    { "type": "text", "id": "button_label_ar", "label": "Button label", "default": "أبلغوني عند الافتتاح" },
    { "type": "header", "content": "Get notified popup (English)" },
    { "type": "text", "id": "notify_heading", "label": "Popup heading", "default": "Get Notified" },
    { "type": "text", "id": "notify_text", "label": "Popup text", "default": "Sign up and get notified when Omarieden launches." },
    { "type": "text", "id": "label_email", "label": "Email label", "default": "Email Address" },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "you@example.com" },
    { "type": "text", "id": "label_phone", "label": "Phone label", "default": "Phone Number (Optional)" },
    { "type": "text", "id": "customer_tag", "label": "Customer tag", "default": "coming-soon" },
    { "type": "text", "id": "success_heading", "label": "Success heading", "default": "You're on the list" },
    { "type": "text", "id": "success_text", "label": "Success text", "default": "We will write the moment the doors open." },
    { "type": "header", "content": "Get notified popup (Arabic)" },
    { "type": "text", "id": "notify_heading_ar", "label": "Popup heading", "default": "أبلغوني عند الافتتاح" },
    { "type": "text", "id": "notify_text_ar", "label": "Popup text", "default": "سجّلوا بريدكم ونبلغكم أول ما يفتح أومارييدن." },
    { "type": "text", "id": "label_email_ar", "label": "Email label", "default": "البريد الإلكتروني" },
    { "type": "text", "id": "label_phone_ar", "label": "Phone label", "default": "رقم الجوال (اختياري)" },
    { "type": "text", "id": "success_heading_ar", "label": "Success heading", "default": "تم التسجيل" },
    { "type": "text", "id": "success_text_ar", "label": "Success text", "default": "راح نراسلكم أول ما تفتح الأبواب." },
    { "type": "header", "content": "Footer" },
    { "type": "checkbox", "id": "show_social", "label": "Show social links", "default": true },
    { "type": "url", "id": "instagram", "label": "Instagram" },
    { "type": "url", "id": "tiktok", "label": "TikTok" },
    { "type": "url", "id": "whatsapp", "label": "WhatsApp" }
  ]
}
{% endschema %}
