{%- capture od_locked -%}{%- render 'prive-locked' -%}{%- endcapture -%}
{%- unless od_locked contains 'yes' -%}
{%- comment -%} Block library 6: text (eyebrow, heading, rich text, button; centred or left; narrow or wide). {%- endcomment -%}
{%- liquid
  assign st = section.settings
-%}
<section class="od-blk od-textblk od-textblk--{{ st.width }}" id="od-text-{{ section.id }}" style="--od-blk-bg: {{ st.bg | default: 'transparent' }}; --od-blk-text: {{ st.text_color }}; padding-top: {{ st.pad_top }}px; padding-bottom: {{ st.pad_bottom }}px;">
  <div class="_container_1kxnl_30">
    <div class="od-textblk__inner">
      {%- render 'od-block-head', eyebrow: st.eyebrow, heading: st.heading, text: st.text, align: st.align, size: st.size -%}
      {%- if st.button_label != blank -%}<div class="od-blk__actions od-blk__actions--{{ st.align }}">{% render 'od-button', label: st.button_label, url: st.button_url, style: st.button_style, color: st.button_color, text_color: st.button_text_color %}</div>{%- endif -%}
    </div>
  </div>
</section>
{%- endunless -%}

{% schema %}
{
  "name": "Text",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The lounge" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>A quiet room above the store, for fittings, previews and a good coffee.</p>" },
    { "type": "select", "id": "align", "label": "Alignment", "default": "center", "options": [ { "value": "center", "label": "Centre" }, { "value": "start", "label": "Left (right in Arabic)" } ] },
    { "type": "select", "id": "width", "label": "Width", "default": "narrow", "options": [ { "value": "narrow", "label": "Narrow (reading column)" }, { "value": "wide", "label": "Wide" } ] },
    { "type": "select", "id": "size", "label": "Heading size", "default": "m", "options": [ { "value": "s", "label": "Small" }, { "value": "m", "label": "Medium" }, { "value": "l", "label": "Large" } ] },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "select", "id": "button_style", "label": "Button style", "default": "outline", "options": [ { "value": "outline", "label": "Outline" }, { "value": "solid", "label": "Solid" }, { "value": "link", "label": "Text link" } ] },
    { "type": "color", "id": "button_color", "label": "Button colour", "default": "#551c25" },
    { "type": "color", "id": "button_text_color", "label": "Button text colour (solid)", "default": "#fcf8f2" },
    { "type": "color", "id": "bg", "label": "Background (empty = none)" },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#551c25" },
    { "type": "range", "id": "pad_top", "label": "Space above", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "pad_bottom", "label": "Space below", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 }
  ],
  "presets": [ { "name": "Text" } ]
}
{% endschema %}
