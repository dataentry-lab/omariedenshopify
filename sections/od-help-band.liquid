{%- comment -%}
  Help band (28 Oct 2026): full-width brand-maroon band, centred Moonlight heading, one line of text, outline button.
  Brand rule: maroon #551c25 only (never the dark maroon). EN settings with *_ar twins. CSS: od-blocks.css (.od-help).
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign rtl = false
  if request.locale.iso_code contains 'ar'
    assign rtl = true
  endif
  assign heading = st.heading
  assign text = st.text
  assign btn = st.button_label
  if rtl
    assign heading = st.heading_ar | default: heading
    assign text = st.text_ar | default: text
    assign btn = st.button_label_ar | default: btn
  endif
  assign link = st.button_link | default: '/pages/contact-us'
-%}
<section class="od-help" id="od-help-{{ section.id }}" style="--od-help-bg: {{ st.bg }}; --od-help-text: {{ st.text_color }}; padding-top: {{ st.pad }}px; padding-bottom: {{ st.pad }}px;">
  <div class="_container_1kxnl_30">
    <div class="od-help__inner">
      {%- if heading != blank -%}<h2 class="od-help__heading">{{ heading }}</h2>{%- endif -%}
      {%- if text != blank -%}<p class="od-help__text">{{ text }}</p>{%- endif -%}
      {%- if btn != blank -%}<a class="od-help__btn" href="{{ link }}">{{ btn }}</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Help band",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Need a hand?" },
    { "type": "text", "id": "heading_ar", "label": "Heading (Arabic)", "default": "تحتاج مساعدة؟" },
    { "type": "text", "id": "text", "label": "Text", "default": "WhatsApp or email us, Sunday to Thursday 10am to 11pm." },
    { "type": "text", "id": "text_ar", "label": "Text (Arabic)", "default": "راسلنا عبر واتساب أو البريد الإلكتروني، من الأحد إلى الخميس من 10 صباحاً إلى 11 مساءً." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Contact us" },
    { "type": "text", "id": "button_label_ar", "label": "Button (Arabic)", "default": "تواصل معنا" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#551c25" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#fcf8f2" },
    { "type": "range", "id": "pad", "label": "Vertical padding", "min": 24, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [ { "name": "Help band" } ]
}
{% endschema %}
