{%- comment -%}
  Cafe seasonal menu (e.g. Dates menu): plain cream cards in a static grid that wraps (all items always visible),
  background image + overlay, per-row setting, heading / text blocks between items. Items are blocks, not products.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign rtl = false
  if request.locale.iso_code contains 'ar'
    assign rtl = true
  endif
  assign eyebrow = st.eyebrow
  assign heading = st.heading
  assign intro = st.text
  assign tab_label = st.tab_label | default: st.heading
  if rtl
    assign eyebrow = st.eyebrow_ar | default: st.eyebrow
    assign heading = st.heading_ar | default: st.heading
    assign intro = st.text_ar | default: st.text
    assign tab_label = st.tab_label_ar | default: st.heading_ar | default: tab_label
  endif
-%}
<section class="od-blk od-cafe od-cseason{% if st.photo_pos == 'top' %} od-cseason--phototop{% endif %}" id="cafe-{{ section.id }}" data-cafe-category data-cafe-label="{{ tab_label | escape }}" data-cafe-seasonal
  style="--od-blk-text: {{ st.text_color }}; --od-accent: {{ st.accent }}; --od-overlay: {{ st.overlay_color }}; --od-overlay-o: {{ st.overlay_opacity | divided_by: 100.0 }}; --od-card-bg: {{ st.card_bg }}; --od-card-text: {{ st.card_text }}; --od-cols: {{ st.per_row }}; --od-cols-m: {{ st.per_row_mobile }}; --od-cafe-bg: {{ st.bg }}; padding-top: {{ st.pad_top }}px; padding-bottom: {{ st.pad_bottom }}px;">
  <div class="od-cseason__media">
    {%- if st.image != blank -%}<img class="od-cseason__img" src="{{ st.image | image_url: width: 2400 }}" alt="" width="{{ st.image.width }}" height="{{ st.image.height }}" loading="lazy">{%- endif -%}
    {%- if st.image_mobile != blank -%}<img class="od-cseason__img od-cseason__img--mobile" src="{{ st.image_mobile | image_url: width: 1000 }}" alt="" width="{{ st.image_mobile.width }}" height="{{ st.image_mobile.height }}" loading="lazy">{%- endif -%}
    <div class="od-cseason__overlay"></div>
  </div>
  <div class="_container_1kxnl_30 od-cseason__inner">
    {%- render 'od-block-head', eyebrow: eyebrow, heading: heading, text: intro -%}
    <div class="od-cseason__grid">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            <h3 class="od-cseason__sub" {{ block.shopify_attributes }}>{{ b.text }}</h3>
          {%- when 'text' -%}
            <div class="od-cseason__note od-blk__text" {{ block.shopify_attributes }}>{{ b.text }}</div>
          {%- else -%}
            {%- if b.hide -%}{%- continue -%}{%- endif -%}
            <article class="od-stamp" {{ block.shopify_attributes }}>
              <div class="od-stamp__inner">
                {%- if rtl -%}
                  {%- if b.name_ar != blank -%}<p class="od-stamp__ar" dir="rtl">{{ b.name_ar }}</p>{%- endif -%}
                  {%- if st.ornament -%}<div class="od-stamp__line"><span aria-hidden="true">&#10048;</span></div>{%- endif -%}
                  {%- if st.show_alt or b.name_ar == blank -%}<h4 class="od-stamp__name">{{ b.name }}</h4>{%- endif -%}
                {%- else -%}
                  <h4 class="od-stamp__name od-stamp__name--top">{{ b.name }}</h4>
                  {%- if st.ornament -%}<div class="od-stamp__line"><span aria-hidden="true">&#10048;</span></div>{%- endif -%}
                  {%- if st.show_alt and b.name_ar != blank -%}<p class="od-stamp__ar od-stamp__ar--under" dir="rtl">{{ b.name_ar }}</p>{%- endif -%}
                {%- endif -%}
                {%- if b.image != blank -%}
                  <div class="od-stamp__img od-ratio od-ratio--{{ st.ratio }}"><img src="{{ b.image | image_url: width: 800 }}" alt="{{ b.name | escape }}" width="{{ b.image.width }}" height="{{ b.image.height }}" loading="lazy"></div>
                {%- endif -%}
                {%- if rtl and b.desc_ar != blank -%}<p class="od-stamp__desc">{{ b.desc_ar }}</p>{%- elsif b.desc != blank -%}<p class="od-stamp__desc">{{ b.desc }}</p>{%- endif -%}
                {%- if b.calories != blank or b.allergens -%}<p class="od-stamp__meta">{% if b.calories != blank %}{{ b.calories }} {{ 'cafe.cal' | t }}{% endif %}{% if b.allergens %}{% if b.calories != blank %} · {% endif %}<span title="{{ b.allergen_note | escape }}">{{ 'cafe.allergens' | t }}</span>{% endif %}</p>{%- endif -%}
                {%- if b.tag != 'none' and b.tag != blank -%}<span class="od-cafe-tag od-cafe-tag--{{ b.tag }}">{% assign tagkey = 'cafe.tags.' | append: b.tag %}{{ tagkey | t }}</span>{%- endif -%}
                {%- if b.price != blank -%}<p class="od-stamp__price">{% render 'sar' %}{{ b.price }}</p>{%- endif -%}
              </div>
            </article>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Super Botanical seasonal",
  "tag": "section",
  "max_blocks": 50,
  "settings": [
    { "type": "text", "id": "tab_label", "label": "Tab label", "default": "Seasonal" },
    { "type": "text", "id": "tab_label_ar", "label": "Tab label (Arabic)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Seasonal" },
    { "type": "text", "id": "eyebrow_ar", "label": "Eyebrow (Arabic)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Dates menu" },
    { "type": "text", "id": "heading_ar", "label": "Heading (Arabic)" },
    { "type": "richtext", "id": "text", "label": "Subtext" },
    { "type": "richtext", "id": "text_ar", "label": "Text (Arabic)" },
    { "type": "checkbox", "id": "show_alt", "label": "Show the name in both languages", "default": false },
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "image", "label": "Background image (desktop)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Background image (mobile)" },
    { "type": "color", "id": "bg", "label": "Background colour (no image)", "default": "#182c29" },
    { "type": "color", "id": "overlay_color", "label": "Overlay colour", "default": "#182c29" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 55 },
    { "type": "color", "id": "text_color", "label": "Heading text colour", "default": "#f0d58e" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#f0d58e" },
    { "type": "header", "content": "Cards" },
    { "type": "range", "id": "per_row", "label": "Items per row (desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "select", "id": "per_row_mobile", "label": "Items per row (mobile)", "default": "2", "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" } ] },
    { "type": "select", "id": "photo_pos", "label": "Photo position", "default": "under", "options": [ { "value": "under", "label": "Under the name" }, { "value": "top", "label": "On top of the card" } ] },
    { "type": "checkbox", "id": "ornament", "label": "Ornament line under the Arabic name", "default": true },
    { "type": "select", "id": "ratio", "label": "Photo shape", "default": "1-1", "options": [ { "value": "1-1", "label": "Square" }, { "value": "4-5", "label": "Portrait" } ] },
    { "type": "color", "id": "card_bg", "label": "Card colour", "default": "#f5efe3" },
    { "type": "color", "id": "card_text", "label": "Card text colour", "default": "#182c29" },
    { "type": "range", "id": "pad_top", "label": "Space above", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "pad_bottom", "label": "Space below", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    { "type": "item", "name": "Menu item", "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo" },
      { "type": "text", "id": "name", "label": "Name (English)", "default": "Dates bar" },
      { "type": "text", "id": "name_ar", "label": "Name (Arabic)", "default": "بار التمر" },
      { "type": "textarea", "id": "desc", "label": "Description (English)", "default": "A rich date and sesame layer, topped with a smooth white chocolate layer." },
      { "type": "textarea", "id": "desc_ar", "label": "Description (Arabic)" },
      { "type": "text", "id": "price", "label": "Price", "default": "32" },
      { "type": "text", "id": "calories", "label": "Calories" },
      { "type": "checkbox", "id": "allergens", "label": "Contains allergens", "default": false },
      { "type": "text", "id": "allergen_note", "label": "Allergen note" },
      { "type": "select", "id": "tag", "label": "Tag", "default": "none", "options": [ { "value": "none", "label": "None" }, { "value": "new", "label": "New" }, { "value": "signature", "label": "Signature" }, { "value": "seasonal", "label": "Seasonal" }, { "value": "best", "label": "Best seller" }, { "value": "vegetarian", "label": "Vegetarian" }, { "value": "vegan", "label": "Vegan" }, { "value": "black", "label": "Black coffee" } ] },
      { "type": "checkbox", "id": "hide", "label": "Hide (sold out today)", "default": false }
    ] },
    { "type": "heading", "name": "Heading", "settings": [ { "type": "text", "id": "text", "label": "Heading", "default": "Drinks" } ] },
    { "type": "text", "name": "Text", "settings": [ { "type": "richtext", "id": "text", "label": "Text" } ] }
  ],
  "presets": [ { "name": "Super Botanical seasonal", "blocks": [ { "type": "item" }, { "type": "item", "settings": { "name": "Date cheesecake", "name_ar": "تشيزكيك التمر", "desc": "From the essence of the past to the present, a creamy date cheesecake topped with warm date sauce.", "price": "36" } }, { "type": "item", "settings": { "name": "Matcha rose", "name_ar": "ماتشا الورد", "desc": "Ceremonial matcha with Taif rose.", "price": "30" } } ] } ]
}
{% endschema %}
