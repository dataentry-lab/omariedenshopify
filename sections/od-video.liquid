{%- capture od_locked -%}{%- render 'prive-locked' -%}{%- endcapture -%}
{%- unless od_locked contains 'yes' -%}
{%- comment -%} Block library 10: video (uploaded or YouTube / Vimeo), cover image, autoplay muted or click to play. {%- endcomment -%}
{%- liquid
  assign st = section.settings
-%}
<section class="od-blk od-video" id="od-video-{{ section.id }}" style="padding-top: {{ st.pad_top }}px; padding-bottom: {{ st.pad_bottom }}px; --od-blk-text: {{ st.text_color }};">
  <div class="{% unless st.full_width %}_container_1kxnl_30{% endunless %}">
    {%- render 'od-block-head', eyebrow: st.eyebrow, heading: st.heading, text: st.text -%}
    <div class="od-video__frame od-ratio od-ratio--{{ st.ratio }}" data-od-video>
      {%- if st.video != blank -%}
        {%- if st.autoplay -%}
          {{ st.video | video_tag: image_size: '1800x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
        {%- else -%}
          {{ st.video | video_tag: image_size: '1800x', controls: true, playsinline: true }}
        {%- endif -%}
      {%- elsif st.video_url != blank -%}
        {%- if st.autoplay -%}
          {{ st.video_url | external_video_tag: autoplay: true, muted: true, loop: true, controls: false, playsinline: true }}
        {%- else -%}
          {%- if st.cover != blank -%}
            <button type="button" class="od-video__cover" data-od-video-play>
              <img src="{{ st.cover | image_url: width: 1800 }}" alt="{{ st.cover.alt | escape }}" width="{{ st.cover.width }}" height="{{ st.cover.height }}" loading="lazy">
              <span class="od-video__play">{% render 'od-icon', name: 'play' %}</span>
            </button>
            <template data-od-video-embed>{{ st.video_url | external_video_tag: autoplay: true }}</template>
          {%- else -%}
            {{ st.video_url | external_video_tag }}
          {%- endif -%}
        {%- endif -%}
      {%- else -%}
        <div class="od-video__placeholder">{% render 'od-icon', name: 'play' %}</div>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endunless -%}

{% schema %}
{
  "name": "Video",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "video", "id": "video", "label": "Uploaded video" },
    { "type": "video_url", "id": "video_url", "label": "Or YouTube / Vimeo link", "accept": [ "youtube", "vimeo" ] },
    { "type": "image_picker", "id": "cover", "label": "Cover image (click to play, YouTube / Vimeo only)" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay muted, looped", "default": true },
    { "type": "select", "id": "ratio", "label": "Shape", "default": "16-9", "options": [ { "value": "16-9", "label": "Wide 16:9" }, { "value": "21-9", "label": "Cinematic 21:9" }, { "value": "1-1", "label": "Square" }, { "value": "4-5", "label": "Portrait 4:5" } ] },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#551c25" },
    { "type": "range", "id": "pad_top", "label": "Space above", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "pad_bottom", "label": "Space below", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 }
  ],
  "presets": [ { "name": "Video" } ]
}
{% endschema %}
