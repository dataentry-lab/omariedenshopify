{% schema %}
{
  "name": "USP / shipping section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (defaults to the chair image)" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [ { "value": "shipping", "label": "Free shipping" }, { "value": "secure", "label": "Secure payments" }, { "value": "returns", "label": "Free returns" }, { "value": "support", "label": "Need help" } ], "default": "shipping" },
        { "type": "image_picker", "id": "custom_icon", "label": "Custom icon (optional)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Free Shipping" },
        { "type": "text", "id": "text", "label": "Text (use [SAR] for the riyal symbol)", "default": "On orders over [SAR] 500" }
      ]
    }
  ],
  "presets": [
    {
      "name": "USP / shipping section",
      "blocks": [
        { "type": "item", "settings": { "icon": "shipping", "title": "Free Shipping", "text": "On orders over [SAR] 500" } },
        { "type": "item", "settings": { "icon": "secure", "title": "Secure Payments", "text": "100% secure payment solution" } },
        { "type": "item", "settings": { "icon": "returns", "title": "Free Returns", "text": "Within 30 days" } },
        { "type": "item", "settings": { "icon": "support", "title": "Need Help?", "text": "Find all the answers to your questions in our FAQ." } }
      ]
    }
  ]
}
{% endschema %}
