{%- comment -%}
  Self serve returns, "Start a return" form (v3, 22 Oct 2026, client wanted it simple): one centred column with intro text,
  order number + email fields, olive button and one line of policy under it. Submitting sends the customer to sign in
  (one-time code) and on to the Shopify account page (hosted) where every order has its Request return button.
  The order number is kept in sessionStorage only (never in the URL). EN settings with *_ar twins picked on the Arabic locale.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign rtl = false
  if request.locale.iso_code contains 'ar'
    assign rtl = true
  endif
  assign heading = st.heading
  assign text = st.text
  assign l_order = st.label_order
  assign l_email = st.label_email
  assign l_btn = st.button_label
  assign note = st.note
  if rtl
    assign heading = st.heading_ar | default: st.heading
    assign text = st.text_ar | default: st.text
    assign l_order = st.label_order_ar | default: st.label_order
    assign l_email = st.label_email_ar | default: st.label_email
    assign l_btn = st.button_label_ar | default: st.button_label
    assign note = st.note_ar | default: st.note
  endif
  assign return_to = st.return_to | default: routes.account_url
  assign login_url = routes.account_login_url
  if login_url contains '?'
    assign login_url = login_url | append: '&return_to=' | append: return_to
  else
    assign login_url = login_url | append: '?return_to=' | append: return_to
  endif
  if customer
    assign login_url = return_to
  endif
-%}
<section class="od-blk od-rtn od-rtn--centred" id="od-returns-{{ section.id }}" style="--od-blk-bg: {{ st.bg | default: 'transparent' }}; --od-blk-text: {{ st.text_color }}; --od-rtn-btn: {{ st.button_color }}; --od-rtn-btn-text: {{ st.button_text_color }}; padding-top: {{ st.pad_top }}px; padding-bottom: {{ st.pad_bottom }}px;">
  <div class="_container_1kxnl_30">
    <div class="od-rtn__col">
      {%- if heading != blank -%}<h2 class="od-blk__heading od-rtn__heading">{{ heading }}</h2>{%- endif -%}
      {%- if text != blank -%}<div class="od-blk__text od-rtn__intro">{{ text }}</div>{%- endif -%}
      <form class="od-rtn__form" action="{{ login_url }}" method="get" data-returns-form data-go="{{ login_url | escape }}">
        <label class="od-rtn__field"><span>{{ l_order }}</span><input type="text" name="order" inputmode="numeric" autocomplete="off" placeholder="{{ st.placeholder_order | escape }}" data-returns-order></label>
        <label class="od-rtn__field"><span>{{ l_email }}</span><input type="email" name="email" autocomplete="email" placeholder="{{ st.placeholder_email | escape }}"></label>
        <button type="submit" class="od-blk__btn od-blk__btn--solid od-rtn__btn">{{ l_btn }}</button>
      </form>
      {%- if note != blank -%}<p class="od-rtn__note">{{ note }}</p>{%- endif -%}
    </div>
  </div>
</section>
<script>
  (function () {
    var f = document.querySelector('#od-returns-{{ section.id }} [data-returns-form]');
    if (!f) return;
    f.addEventListener('submit', function (e) {
      e.preventDefault();
      var n = f.querySelector('[data-returns-order]');
      try { if (n && n.value) sessionStorage.setItem('od_return_order', n.value.trim()); } catch (err) {}
      location.href = f.getAttribute('data-go');
    });
  })();
</script>

{% schema %}
{
  "name": "Returns: start a return",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (optional)" },
    { "type": "text", "id": "heading_ar", "label": "Heading (Arabic)" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Enter your order number and email. We will send you a one-time code and open your order, where you choose the items to return.</p>" },
    { "type": "richtext", "id": "text_ar", "label": "Text (Arabic)", "default": "<p>أدخل رقم الطلب والبريد الإلكتروني. سنرسل لك رمزاً لمرة واحدة ونفتح طلبك لتختار القطع التي تريد إرجاعها.</p>" },
    { "type": "header", "content": "Form" },
    { "type": "text", "id": "label_order", "label": "Order number label", "default": "Order number" },
    { "type": "text", "id": "label_order_ar", "label": "Order number label (Arabic)", "default": "رقم الطلب" },
    { "type": "text", "id": "placeholder_order", "label": "Order number placeholder", "default": "e.g. #1042" },
    { "type": "text", "id": "label_email", "label": "Email label", "default": "Email address" },
    { "type": "text", "id": "label_email_ar", "label": "Email label (Arabic)", "default": "البريد الإلكتروني" },
    { "type": "text", "id": "placeholder_email", "label": "Email placeholder", "default": "you@example.com" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Start a return" },
    { "type": "text", "id": "button_label_ar", "label": "Button (Arabic)", "default": "ابدأ الإرجاع" },
    { "type": "text", "id": "return_to", "label": "After sign-in, open", "info": "Empty = the Shopify account page with the orders and their Request return button." },
    { "type": "text", "id": "note", "label": "Line under the button", "default": "14 days from delivery · unworn, with tags · refund to your original payment" },
    { "type": "text", "id": "note_ar", "label": "Line under the button (Arabic)", "default": "خلال 14 يوماً من التوصيل · غير مستخدم ومع البطاقات · الاسترداد إلى وسيلة الدفع الأصلية" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg", "label": "Background" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#551c25" },
    { "type": "color", "id": "button_color", "label": "Button", "default": "#595b33" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#ffffff" },
    { "type": "range", "id": "pad_top", "label": "Space above", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "pad_bottom", "label": "Space below", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 }
  ],
  "presets": [ { "name": "Returns: start a return" } ]
}
{% endschema %}
