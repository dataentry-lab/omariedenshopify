{%- comment -%}
  Self serve returns, facts band (22 Oct 2026): full-width maroon strip with 2 to 4 big Moonlight values and small uppercase labels. EN with *_ar twins.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign rtl = false
  if request.locale.iso_code contains 'ar'
    assign rtl = true
  endif
-%}
<section class="od-blk od-rfacts" id="od-rfacts-{{ section.id }}" style="--od-blk-bg: {{ st.bg }}; --od-blk-text: {{ st.text_color }}; padding-top: {{ st.pad_top }}px; padding-bottom: {{ st.pad_bottom }}px;">
  <div class="_container_1kxnl_30">
    <div class="od-rfacts__grid" style="--od-cols: {{ section.blocks.size | at_least: 1 | at_most: 4 }};">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- liquid
          assign value = b.value
          assign label = b.label
          if rtl
            assign value = b.value_ar | default: b.value
            assign label = b.label_ar | default: b.label
          endif
        -%}
        <div class="od-rfacts__item" {{ block.shopify_attributes }}>
          <p class="od-rfacts__value">{{ value }}</p>
          <p class="od-rfacts__label">{{ label }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Returns: facts band",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#551c25" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#fcf8f2" },
    { "type": "range", "id": "pad_top", "label": "Space above", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "pad_bottom", "label": "Space below", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 36 }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "14" },
        { "type": "text", "id": "value_ar", "label": "Value (Arabic)" },
        { "type": "text", "id": "label", "label": "Label", "default": "days to return" },
        { "type": "text", "id": "label_ar", "label": "Label (Arabic)" }
      ]
    }
  ],
  "presets": [ { "name": "Returns: facts band", "blocks": [ { "type": "fact" }, { "type": "fact", "settings": { "value": "Free", "label": "pickup in KSA" } }, { "type": "fact", "settings": { "value": "5 to 7", "label": "working days refund" } }, { "type": "fact", "settings": { "value": "In store", "label": "exchanges welcome" } } ] } ]
}
{% endschema %}
