{%- comment -%}
  Catalogue book (round 11): one Shopify page with the "catalogue" template = one catalogue.
  Every block is one page of the book: cover, products (2-4 products, title top / bottom, background), image, text, back cover.
  Reader (assets/od-catalogue.js + .css): one page at a time, real page-curl turn (strips peel from the outer edge),
  arrows, counter, thumbnails, fullscreen, share, keyboard, drag on touch. Product tiles open the shared quick view.
  The hub section (sections/od-catalogues.liquid) lists every page that uses this template.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign rtl = false
  if request.locale.iso_code contains 'ar'
    assign rtl = true
  endif
  assign n = section.blocks.size
-%}
{{ 'od-catalogue.css' | asset_url | stylesheet_tag }}
<div class="od-cat od-cat--{{ st.size }}{% if rtl %} od-cat--rtl{% endif %}" data-od-catalogue data-section-id="{{ section.id }}" data-pages="{{ n }}" data-title="{{ page.title | escape }}" data-dir="{% if rtl %}rtl{% else %}ltr{% endif %}" style="--od-cat-bg: {{ st.stage_bg }}; --od-cat-text: {{ st.text_color }}; --od-cat-accent: {{ st.accent }};">
  <div class="_container_1kxnl_30 od-cat__wrap">
    <div class="od-cat__top">
      {%- if st.back_url != blank -%}<a class="od-cat__back" href="{{ st.back_url }}">&lsaquo; {{ st.back_label | default: 'Catalogues' }}</a>{%- else -%}<span></span>{%- endif -%}
      <h1 class="od-cat__title">{{ page.title }}</h1>
      <div class="od-cat__tools">
        <button type="button" class="od-cat__tool" data-cat-thumbs aria-label="{{ 'catalogue.pages' | t }}" title="{{ 'catalogue.pages' | t }}"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="7" height="16"/><rect x="14" y="4" width="7" height="16"/></svg></button>
        <button type="button" class="od-cat__tool" data-cat-share aria-label="{{ 'catalogue.share' | t }}" title="{{ 'catalogue.share' | t }}"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"/></svg></button>
        <button type="button" class="od-cat__tool" data-cat-full aria-label="{{ 'catalogue.fullscreen' | t }}" title="{{ 'catalogue.fullscreen' | t }}"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg></button>
      </div>
    </div>

    <div class="od-cat__stage" data-cat-stage>
      <button type="button" class="od-cat__nav od-cat__nav--prev" data-cat-prev aria-label="{{ 'catalogue.prev' | t }}"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg></button>
      <div class="od-cat__book" data-cat-book>
        <div class="od-cat__under" data-cat-under></div>
        <div class="od-cat__current" data-cat-current></div>
        <div class="od-cat__strips" data-cat-strips aria-hidden="true"></div>
        <div class="od-cat__hint" data-cat-hint aria-hidden="true"><span>{{ 'catalogue.hint' | t }}</span></div>
      </div>
      <button type="button" class="od-cat__nav od-cat__nav--next" data-cat-next aria-label="{{ 'catalogue.next' | t }}"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg></button>
    </div>

    <div class="od-cat__bar">
      <div class="od-cat__progress" aria-hidden="true"><i data-cat-progress></i></div>
      <p class="od-cat__count"><span data-cat-count>1</span> / {{ n }}</p>
    </div>

    <div class="od-cat__thumbs" data-cat-thumbstrip hidden>
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <button type="button" class="od-cat__thumb" data-cat-go="{{ forloop.index0 }}" aria-label="{{ 'catalogue.page' | t }} {{ forloop.index }}">
          {%- case block.type -%}
            {%- when 'cover' or 'image' or 'back' -%}
              {%- if b.image != blank -%}<img src="{{ b.image | image_url: width: 160 }}" alt="" loading="lazy">{%- endif -%}
            {%- when 'products' -%}
              {%- for p in b.products limit: 1 -%}{%- if p.featured_image -%}<img src="{{ p.featured_image | image_url: width: 160 }}" alt="" loading="lazy">{%- endif -%}{%- endfor -%}
          {%- endcase -%}
          <span>{{ forloop.index }}</span>
        </button>
      {%- endfor -%}
    </div>

    {%- comment -%} the pages themselves (hidden; the reader copies the active one into the stage) {%- endcomment -%}
    <div class="od-cat__pages" data-cat-pages hidden>
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- assign tc = b.text_color | default: '#551c25' -%}
        <div class="od-cat__page od-cat__page--{{ block.type }} od-cat__page--align-{{ b.align | default: 'center' }}" data-cat-page="{{ forloop.index0 }}" {{ block.shopify_attributes }} style="color: {{ tc }};{% if b.bg_color != blank and b.bg_color != 'rgba(0,0,0,0)' %} background: {{ b.bg_color }};{% endif %}">
          {%- if b.image != blank and block.type != 'text' -%}
            <img class="od-cat__bgimg{% if block.type == 'products' %} od-cat__bgimg--soft{% endif %}" src="{{ b.image | image_url: width: 1400 }}" alt="{{ b.image.alt | escape }}" loading="lazy" width="{{ b.image.width }}" height="{{ b.image.height }}">
          {%- elsif b.image != blank -%}
            <img class="od-cat__bgimg od-cat__bgimg--soft" src="{{ b.image | image_url: width: 1400 }}" alt="" loading="lazy" width="{{ b.image.width }}" height="{{ b.image.height }}">
          {%- endif -%}
          {%- if b.overlay_opacity > 0 and b.image != blank -%}<div class="od-cat__overlay" style="background: {{ b.overlay_color }}; opacity: {{ b.overlay_opacity | divided_by: 100.0 }};"></div>{%- endif -%}

          {%- case block.type -%}
            {%- when 'cover' or 'back' -%}
              <div class="od-cat__cover od-cat__cover--{{ b.position | default: 'bottom' }}">
                {%- if b.eyebrow != blank -%}<p class="od-cat__eyebrow">{{ b.eyebrow }}</p>{%- endif -%}
                {%- if b.heading != blank -%}<h2 class="od-cat__heading">{{ b.heading }}</h2>{%- endif -%}
                {%- if b.text != blank -%}<div class="od-cat__text">{{ b.text }}</div>{%- endif -%}
              </div>

            {%- when 'image' -%}
              {%- if b.caption != blank -%}<p class="od-cat__caption od-cat__caption--{{ b.position | default: 'bottom' }}">{{ b.caption }}</p>{%- endif -%}

            {%- when 'text' -%}
              <div class="od-cat__textpage">
                {%- if b.eyebrow != blank -%}<p class="od-cat__eyebrow">{{ b.eyebrow }}</p>{%- endif -%}
                {%- if b.heading != blank -%}<h2 class="od-cat__heading">{{ b.heading }}</h2>{%- endif -%}
                {%- if b.text != blank -%}<div class="od-cat__text od-cat__text--long">{{ b.text }}</div>{%- endif -%}
              </div>

            {%- when 'products' -%}
              {%- assign count = b.products.count -%}
              {%- if count > 4 -%}{%- assign count = 4 -%}{%- endif -%}
              <div class="od-cat__prodpage od-cat__prodpage--title-{{ b.position | default: 'top' }}">
                {%- if b.heading != blank -%}<h2 class="od-cat__heading od-cat__heading--sm">{{ b.heading }}</h2>{%- endif -%}
                <div class="od-cat__grid od-cat__grid--{{ count }}{% if b.layout == 'feature' and count == 3 %} od-cat__grid--feature{% endif %}">
                  {%- for p in b.products limit: 4 -%}
                    {%- assign code = p.metafields.custom.style_code | default: p.selected_or_first_available_variant.sku -%}
                    <div class="od-cat__prod" data-qa-source data-handle="{{ p.handle }}">
                      {%- render 'product-json', product: p -%}
                      <button type="button" class="od-cat__prod-btn" data-quick-add-open aria-label="{{ p.title | escape }}">
                        <span class="od-cat__prod-img">{%- if p.featured_image -%}<img src="{{ p.featured_image | image_url: width: 600 }}" alt="{{ p.featured_image.alt | escape }}" loading="lazy" width="{{ p.featured_image.width }}" height="{{ p.featured_image.height }}">{%- endif -%}</span>
                        {%- if b.show_brand and p.vendor != blank -%}<span class="od-cat__prod-brand">{{ p.vendor }}</span>{%- endif -%}
                        <span class="od-cat__prod-name">{{ p.title }}</span>
                        <span class="od-cat__prod-meta">
                          {%- if b.show_code and code != blank -%}<span class="od-cat__prod-code">{{ code }}</span>{%- endif -%}
                          {%- if b.show_price -%}<span class="od-cat__prod-price">{% render 'sar' %}{{ p.price | money_without_currency }}</span>{%- endif -%}
                        </span>
                      </button>
                    </div>
                  {%- endfor -%}
                  {%- if count == 0 and request.design_mode -%}<p class="od-cat__empty">Pick 2 to 4 products for this page.</p>{%- endif -%}
                </div>
              </div>
          {%- endcase -%}
        </div>
      {%- endfor -%}
      {%- if n == 0 -%}<div class="od-cat__page" data-cat-page="0"><div class="od-cat__textpage"><h2 class="od-cat__heading">{{ page.title }}</h2>{%- if request.design_mode -%}<p>Add pages with the blocks on the left (Cover, Products page, Image page, Text page, Back cover).</p>{%- endif -%}</div></div>{%- endif -%}
    </div>
  </div>
</div>
<script src="{{ 'od-catalogue.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Catalogue book",
  "tag": "section",
  "class": "od-catalogue-section",
  "max_blocks": 50,
  "settings": [
    { "type": "paragraph", "content": "One page of the book per block. Drag blocks to reorder the pages. Cover images work best at 3:4 (portrait)." },
    { "type": "select", "id": "size", "label": "Page size on desktop", "default": "m", "options": [ { "value": "s", "label": "Small" }, { "value": "m", "label": "Medium" }, { "value": "l", "label": "Large" } ] },
    { "type": "text", "id": "back_label", "label": "Back link label", "default": "Catalogues" },
    { "type": "url", "id": "back_url", "label": "Back link (the catalogues page)" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "stage_bg", "label": "Background around the book", "default": "#fcf8f2" },
    { "type": "color", "id": "text_color", "label": "Title, counter and buttons", "default": "#551c25" },
    { "type": "color", "id": "accent", "label": "Progress bar", "default": "#551c25" }
  ],
  "blocks": [
    {
      "type": "cover",
      "name": "Cover",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Cover image (3:4)" },
        { "type": "color", "id": "bg_color", "label": "Background colour (no image)", "default": "#e5d9c7" },
        { "type": "text", "id": "eyebrow", "label": "Small line", "default": "Spring 26" },
        { "type": "text", "id": "heading", "label": "Title" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "select", "id": "position", "label": "Text position", "default": "bottom", "options": [ { "value": "top", "label": "Top" }, { "value": "center", "label": "Centre" }, { "value": "bottom", "label": "Bottom" } ] },
        { "type": "select", "id": "align", "label": "Text alignment", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }, { "value": "right", "label": "Right" } ] },
        { "type": "color", "id": "text_color", "label": "Text colour", "default": "#fcf8f2" },
        { "type": "color", "id": "overlay_color", "label": "Overlay colour", "default": "#2a0d12" },
        { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 20 }
      ]
    },
    {
      "type": "products",
      "name": "Products page",
      "settings": [
        { "type": "product_list", "id": "products", "label": "Products (2 to 4)", "limit": 4 },
        { "type": "text", "id": "heading", "label": "Title" },
        { "type": "select", "id": "position", "label": "Title position", "default": "top", "options": [ { "value": "top", "label": "Top" }, { "value": "bottom", "label": "Bottom" } ] },
        { "type": "select", "id": "layout", "label": "Layout with 3 products", "default": "row", "options": [ { "value": "row", "label": "3 in a row" }, { "value": "feature", "label": "1 big + 2 small" } ] },
        { "type": "checkbox", "id": "show_brand", "label": "Show brand", "default": true },
        { "type": "checkbox", "id": "show_code", "label": "Show style code (custom.style_code or SKU)", "default": true },
        { "type": "checkbox", "id": "show_price", "label": "Show price", "default": true },
        { "type": "image_picker", "id": "image", "label": "Background image (optional)" },
        { "type": "color", "id": "bg_color", "label": "Background colour", "default": "#fcf8f2" },
        { "type": "color", "id": "overlay_color", "label": "Overlay colour (over the image)", "default": "#fcf8f2" },
        { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 40 },
        { "type": "color", "id": "text_color", "label": "Text colour", "default": "#551c25" }
      ]
    },
    {
      "type": "image",
      "name": "Image page",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (3:4)" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "select", "id": "position", "label": "Caption position", "default": "bottom", "options": [ { "value": "top", "label": "Top" }, { "value": "bottom", "label": "Bottom" } ] },
        { "type": "select", "id": "align", "label": "Caption alignment", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }, { "value": "right", "label": "Right" } ] },
        { "type": "color", "id": "text_color", "label": "Caption colour", "default": "#fcf8f2" },
        { "type": "color", "id": "overlay_color", "label": "Overlay colour", "default": "#2a0d12" },
        { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 0 }
      ]
    },
    {
      "type": "text",
      "name": "Text page",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Small line" },
        { "type": "text", "id": "heading", "label": "Title" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "select", "id": "align", "label": "Alignment", "default": "center", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }, { "value": "right", "label": "Right" } ] },
        { "type": "image_picker", "id": "image", "label": "Background image (optional)" },
        { "type": "color", "id": "bg_color", "label": "Background colour", "default": "#fcf8f2" },
        { "type": "color", "id": "overlay_color", "label": "Overlay colour (over the image)", "default": "#fcf8f2" },
        { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 40 },
        { "type": "color", "id": "text_color", "label": "Text colour", "default": "#551c25" }
      ]
    },
    {
      "type": "back",
      "name": "Back cover",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (3:4)" },
        { "type": "color", "id": "bg_color", "label": "Background colour (no image)", "default": "#2a0d12" },
        { "type": "text", "id": "eyebrow", "label": "Small line" },
        { "type": "text", "id": "heading", "label": "Title", "default": "OMARIEDEN" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "select", "id": "position", "label": "Text position", "default": "center", "options": [ { "value": "top", "label": "Top" }, { "value": "center", "label": "Centre" }, { "value": "bottom", "label": "Bottom" } ] },
        { "type": "select", "id": "align", "label": "Text alignment", "default": "center", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }, { "value": "right", "label": "Right" } ] },
        { "type": "color", "id": "text_color", "label": "Text colour", "default": "#e5d9c7" },
        { "type": "color", "id": "overlay_color", "label": "Overlay colour", "default": "#2a0d12" },
        { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 20 }
      ]
    }
  ]
}
{% endschema %}
