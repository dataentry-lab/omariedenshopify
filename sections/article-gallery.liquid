{%- comment -%} Recap photo gallery: images from the article field custom.gallery (up to 12), grid with lightbox. {%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign gallery = article.metafields.custom.gallery.value
-%}
{%- if gallery != blank and gallery.size > 0 -%}
<section class="od-blk od-agal" style="--od-blk-text: {{ st.text_color }}; padding-top: {{ st.pad_top }}px; padding-bottom: {{ st.pad_bottom }}px;">
  <div class="_container_1kxnl_30">
    {%- render 'od-block-head', eyebrow: st.eyebrow, heading: st.heading, text: st.text -%}
    <div class="od-agal__grid od-agal__grid--{{ st.layout }}" data-od-gallery="true">
      {%- for im in gallery limit: 12 -%}
        <button type="button" class="od-agal__item" data-od-zoom="{{ im | image_url: width: 2000 }}" aria-label="{{ 'blogs.news.open_photo' | t: n: forloop.index }}">
          <img src="{{ im | image_url: width: 900 }}" alt="" width="900" height="900" loading="lazy">
        </button>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Recap gallery",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Shows the photos added to the article field \"Gallery\" (custom.gallery), up to 12. Click opens a lightbox." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The photos" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "mosaic", "options": [ { "value": "mosaic", "label": "Mosaic (first photo large)" }, { "value": "grid", "label": "Even grid" } ] },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#551c25" },
    { "type": "range", "id": "pad_top", "label": "Space above", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "pad_bottom", "label": "Space below", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 }
  ],
  "presets": [ { "name": "Recap gallery" } ]
}
{% endschema %}
