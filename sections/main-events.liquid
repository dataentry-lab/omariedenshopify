{%- comment -%}
  Events listing page (page template "events"): hero handled by blog-hero, tabs Upcoming / All / Past (client-side filter),
  sorted by date, 4-up event cards with automatic + manual tags, price from, waitlist link on sold out.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign ev_handle = st.collection | default: settings.events_collection | default: 'events'
  assign coll = collections[ev_handle]
  assign now_s = 'now' | date: '%s' | plus: 0
  assign keys = ''
  for p in coll.products limit: 100
    assign s = p.metafields.custom.event_start.value | date: '%s' | plus: 0
    assign key = s | prepend: '0000000000' | slice: -10, 10 | append: '::' | append: p.handle
    assign keys = keys | append: key | append: ','
  endfor
  assign sorted = keys | split: ',' | sort
  assign start_tab = request.params.tab | default: 'upcoming'
-%}
<section class="od-blk od-events" style="--od-blk-text: {{ st.text_color }}; --od-accent: {{ st.accent }}; padding-top: {{ st.pad_top }}px; padding-bottom: {{ st.pad_bottom }}px;" data-od-events data-tab="{{ start_tab }}">
  <div class="_container_1kxnl_30">
    {%- render 'od-block-head', eyebrow: st.eyebrow, heading: st.heading, text: st.text -%}
    <div class="od-events__bar">
      <nav class="od-tabs od-events__tabs" aria-label="{{ 'events.listing.all' | t }}">
        <button type="button" class="od-tab" data-ev-tab="upcoming">{{ 'events.listing.upcoming' | t }}</button>
        <button type="button" class="od-tab" data-ev-tab="all">{{ 'events.listing.all' | t }}</button>
        <button type="button" class="od-tab" data-ev-tab="past">{{ 'events.listing.past' | t }}</button>
      </nav>
      <span class="od-events__sort">{{ 'events.listing.sort' | t }}</span>
    </div>
    <div class="od-ev-grid" style="--od-cols: {{ st.per_row }};" data-ev-grid>
      {%- for k in sorted -%}
        {%- assign parts = k | split: '::' -%}
        {%- if parts.size < 2 -%}{%- continue -%}{%- endif -%}
        {%- assign p = all_products[parts[1]] -%}
        {%- if p == blank -%}{%- continue -%}{%- endif -%}
        {%- include 'event-card', product: p -%}
      {%- endfor -%}
    </div>
    <p class="od-blog__empty" data-ev-empty hidden>{{ 'events.listing.empty' | t }}</p>
  </div>
</section>
<script src="{{ 'od-events.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Events list",
  "tag": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Events collection", "info": "Overrides Theme settings > Events. Leave empty to use that one." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "range", "id": "per_row", "label": "Per row (desktop)", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#551c25" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#595b33" },
    { "type": "range", "id": "pad_top", "label": "Space above", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "pad_bottom", "label": "Space below", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 }
  ]
}
{% endschema %}
