{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    {
      "type": "paragraph",
      "content": "Slide-in shopping bag shown when a product is added to the cart or the bag icon is clicked. The /cart page stays available through the \"View my bag\" link."
    },
    {
      "type": "collection",
      "id": "trending_collection",
      "label": "Trending now collection",
      "info": "Products shown in the \"Trending now\" carousel inside the drawer. Falls back to Theme settings > Trending collection, then all products."
    },
    {
      "type": "range",
      "id": "trending_limit",
      "label": "Trending products",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ]
}
{% endschema %}
