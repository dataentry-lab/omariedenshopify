{%- comment -%}
  Cart drawer ("Shopping Bag"). Rendered once in layout/theme.liquid inside #modal and
  re-rendered through the Section Rendering API (?sections=cart-drawer) by assets/od-cart.js.
  Markup reuses the original site's drawer CSS module (_1bfe0 / _1tn6c / _9316i); Shopify-only
  additions are prefixed od-cartd- (assets/od-cart.css).
{%- endcomment -%}
{%- liquid
  assign rtl = false
  if request.locale.iso_code contains 'ar'
    assign rtl = true
  endif
  assign threshold = settings.free_shipping_threshold | default: 500 | times: 100
  assign subtotal = cart.items_subtotal_price
  assign progress = subtotal | times: 100 | divided_by: threshold
  assign remaining = threshold | minus: subtotal
  assign trending = collections[section.settings.trending_collection]
  if trending == blank
    assign trending = collections[settings.trending_collection]
  endif
  if trending == blank
    assign trending = collections.all
  endif
  assign trending_limit = section.settings.trending_limit | default: 8
  assign color_name = settings.color_option_name | default: 'Color'
  assign size_name = settings.size_option_name | default: 'Size'
-%}
<div class="_backdrop_9316i_30 undefined" data-modal-backdrop="cart" data-show-class="_backdropShow_1bfe0_295"></div>
<div class="_modal_9316i_132 undefined od-cartd {% if rtl %}_modalAddClsRtl_1bfe0_251 od-cartd--rtl{% else %}_modalAddCls_1bfe0_251{% endif %}" data-modal="cart" data-show-class="_show_1bfe0_289" data-cart-drawer data-section-id="{{ section.id }}" role="dialog" aria-modal="true" aria-label="{{ 'cart.title' | t }}"
