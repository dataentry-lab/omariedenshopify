            <h4>{{ 'cart.empty.title' | t }}</h4>
            <p>{{ 'cart.empty.text' | t }}</p>
          </div>
          <button type="button" class="_btn_lnddl_30 _shoppingBag_1bfe0_86 od-cartd__shop" data-href="{{ routes.all_products_collection_url }}">{{ 'cart.empty.button' | t }}</button>
        </div>
        <div class="od-cartd__skeleton" data-cartd-skeleton hidden aria-hidden="true">
          <div class="od-skel od-skel--line" style="width: 70%;"></div>
          <div class="od-cartd__skel-item"><div class="od-skel od-cartd__skel-img"></div><div class="od-cartd__skel-text"><div class="od-skel od-skel--line" style="width: 40%;"></div><div class="od-skel od-skel--line" style="width: 80%;"></div><div class="od-skel od-skel--line" style="width: 30%;"></div></div></div>
          <div class="od-cartd__skel-item"><div class="od-skel od-cartd__skel-img"></div><div class="od-cartd__skel-text"><div class="od-skel od-skel--line" style="width: 50%;"></div><div class="od-skel od-skel--line" style="width: 70%;"></div><div class="od-skel od-skel--line" style="width: 30%;"></div></div></div>
