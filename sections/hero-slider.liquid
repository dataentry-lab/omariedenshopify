{%- liquid
  assign rtl = false
  if request.locale.iso_code contains 'ar'
    assign rtl = true
  endif
-%}
<div class="swiper sliderBorder hero_banner {% if rtl %}custom_rtl{% endif %}" dir="{% if rtl %}rtl{% else %}ltr{% endif %}" data-swiper="hero" data-autoplay="{{ section.settings.autoplay_delay | default: 5500 }}">
  <div class="swiper-wrapper">
    {%- for block in section.blocks -%}
      <div class="swiper-slide" {{ block.shopify_attributes }}>
        <section class="_bgBack_xwnoc_133 _bgAddCls_1pc1i_74" style="background-image: url({% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 2560 }}{% else %}{{ 'images_page-banner.jpg' | asset_url }}{% endif %}); height: 500px;">
          {%- if block.settings.mobile_image != blank -%}
            <style>@media (max-width: 768px){ #Slide-{{ section.id }}-{{ forloop.index }} { background-image: url({{ block.settings.mobile_image | image_url: width: 1000 }}) !important; } }</style>
          {%- endif -%}
          <div class="_container_1kxnl_30 _banner_xwnoc_30 undefined" id="Slide-{{ section.id }}-{{ forloop.index }}">
            <div class="_banner__content_xwnoc_61 _addClassContent_1pc1i_30">
              {%- if block.settings.top_subtitle != blank -%}<p class="_banner__content__topsubtitle_xwnoc_103">{{ block.settings.top_subtitle }}</p>{%- endif -%}
              <h1 class="{% if rtl %}_titleRtl_xwnoc_39{% else %}undefined{% endif %} _banner__content__title_xwnoc_67 _titleClass_1pc1i_42">{{ block.settings.title }} </h1>
              {%- if block.settings.subtitle != blank -%}<div class="_banner__content__subtitle_xwnoc_118 undefined">{{ block.settings.subtitle }}</div>{%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <button type="button" class="_btn_lnddl_30 _bannerBtn_xwnoc_30" data-href="{{ block.settings.button_url | default: routes.all_products_collection_url }}">{{ block.settings.button_label }}</button>
              {%- endif -%}
            </div>
          </div>
        </section>
      </div>
    {%- endfor -%}
  </div>
  <div class="swiper-pagination"></div>
</div>

{% schema %}
{
  "name": "Hero slider",
  "settings": [
    { "type": "number", "id": "autoplay_delay", "label": "Autoplay delay (ms)", "default": 5500 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Background image (2560 x 720 recommended)" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile background image (optional)" },
        { "type": "text", "id": "top_subtitle", "label": "Small top line (optional)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Back To Routine" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "New Arrivals, New Routines, New Inspiration, New You." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore" },
        { "type": "url", "id": "button_url", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    { "name": "Hero slider", "blocks": [ { "type": "slide" } ] }
  ]
}
{% endschema %}
