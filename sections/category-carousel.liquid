{%- liquid
  assign rtl = false
  if request.locale.iso_code contains 'ar'
    assign rtl = true
  endif
-%}
<div class="_container_1kxnl_30 _categoryCarousel_14c5y_30 od-home-section">
  <div class="_container_1kxnl_30 od-home-section__inner">
  {%- render 'section-header', title: section.settings.title, button_label: section.settings.button_label, button_url: section.settings.button_url -%}
  <div class="od-carousel">
  <div class="swiper sliderBorder category_carousel {% if rtl %}custom_rtl{% endif %}" dir="{% if rtl %}rtl{% else %}ltr{% endif %}" data-swiper="cards">
    <div class="swiper-wrapper">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = collections[block.settings.collection]
          assign img = block.settings.image | default: c.image
          assign url = block.settings.url | default: c.url
        -%}
        <div class="swiper-slide" {{ block.shopify_attributes }}>
          <div class="_category_card_1rng8_34" data-href="{{ url }}">
            <div class="_category_card__innercard_1rng8_60">
              {%- if img != blank -%}
                <img alt="{{ block.settings.title | default: c.title | escape }}" src="{{ img | image_url: width: 600 }}" width="{{ img.width }}" height="{{ img.height }}" loading="lazy">
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag }}
              {%- endif -%}
              <div class="_category_card__innercard__title_1rng8_79">
                {%- if block.settings.subtitle != blank -%}<h3>{{ block.settings.subtitle }}</h3>{%- endif -%}
                <h2>{{ block.settings.title | default: c.title }}</h2>
                <button type="button" data-href="{{ url }}">{{ section.settings.card_button | default: 'Explore' }}</button>
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
    <div class="swiper-pagination"></div>
  </div>
  <div class="swiper-button-prev"></div>
  <div class="swiper-button-next"></div>
  </div>
  </div>
</div>

{% schema %}
{
  "name": "Category carousel",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Shop by category" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop all" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "text", "id": "card_button", "label": "Card button label", "default": "Explore" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image (defaults to collection image)" },
        { "type": "text", "id": "subtitle", "label": "Small line" },
        { "type": "text", "id": "title", "label": "Title (defaults to collection title)" },
        { "type": "url", "id": "url", "label": "Custom link" }
      ]
    }
  ],
  "presets": [ { "name": "Category carousel", "blocks": [ { "type": "category" }, { "type": "category" }, { "type": "category" }, { "type": "category" }, { "type": "category" } ] } ]
}
{% endschema %}
