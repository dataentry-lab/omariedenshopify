{%- comment -%} "Shop the post" / "Seen at the event": products from the article field custom.products, or hand-picked here. {%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign list = st.products
  if list == blank
    assign list = article.metafields.custom.products.value
  endif
-%}
{%- if list != blank and list.size > 0 -%}
<section class="od-blk od-pgrid" style="--od-blk-text: {{ st.text_color }}; padding-top: {{ st.pad_top }}px; padding-bottom: {{ st.pad_bottom }}px;">
  <div class="_container_1kxnl_30">
    {%- render 'od-block-head', eyebrow: st.eyebrow, heading: st.heading, text: st.text, align: 'center' -%}
    <div class="od-pgrid__grid" style="--od-cols: {{ st.per_row }};">
      {%- for product in list limit: 12 -%}
        <div class="od-pgrid__item">{% render 'product-card', product: product %}</div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Shop the post",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Uses the products picked here, or the article field \"Products\" (custom.products) when empty." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the post" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 12 },
    { "type": "range", "id": "per_row", "label": "Per row (desktop)", "min": 3, "max": 5, "step": 1, "default": 4 },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#551c25" },
    { "type": "range", "id": "pad_top", "label": "Space above", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "pad_bottom", "label": "Space below", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 }
  ],
  "presets": [ { "name": "Shop the post" } ]
}
{% endschema %}
