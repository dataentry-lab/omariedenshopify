{%- comment -%}
  "Upcoming events": the next N events (products in the events collection, soonest first), with buttons to the listing.
  Used on the News & Events page, home page, Privé page and recap pages ("Related events").
{%- endcomment -%}
{%- capture od_locked -%}{%- render 'prive-locked' -%}{%- endcapture -%}
{%- unless od_locked contains 'yes' -%}
{%- liquid
  assign st = section.settings
  assign ev_handle = section.settings.collection | default: settings.events_collection | default: 'events'
  assign coll = collections[ev_handle]
  assign count = st.count | default: 3
  assign now_s = 'now' | date: '%s' | plus: 0
  assign keys = ''
  for p in coll.products limit: 50
    assign s = p.metafields.custom.event_start.value | date: '%s' | plus: 0
    assign e = p.metafields.custom.event_end.value | date: '%s' | plus: 0
    if e == 0
      assign e = s
    endif
    if e >= now_s
      assign key = s | prepend: '0000000000' | slice: -10, 10 | append: '::' | append: p.handle
      assign keys = keys | append: key | append: ','
    endif
  endfor
  assign sorted = keys | split: ',' | sort
-%}
{%- if sorted.size > 0 or request.design_mode -%}
<section class="od-blk od-upcoming" style="--od-blk-bg: {{ st.bg | default: 'transparent' }}; --od-blk-text: {{ st.text_color }}; --od-accent: {{ st.accent }}; padding-top: {{ st.pad_top }}px; padding-bottom: {{ st.pad_bottom }}px;">
  <div class="_container_1kxnl_30">
    <div class="od-upcoming__head">
      {%- render 'od-block-head', eyebrow: st.eyebrow, heading: st.heading, text: st.text, align: 'start' -%}
      <div class="od-upcoming__btns">
        {%- if st.btn1_label != blank -%}<a class="od-blk__btn od-blk__btn--outline" href="{{ st.btn1_url | default: pages[settings.events_page].url }}">{{ st.btn1_label }}</a>{%- endif -%}
        {%- if st.btn2_label != blank -%}<a class="od-blk__btn od-blk__btn--link" href="{{ st.btn2_url | default: pages[settings.events_page].url }}{% if st.btn2_url == blank %}?tab=all{% endif %}">{{ st.btn2_label }}</a>{%- endif -%}
      </div>
    </div>
    {%- if sorted.size > 0 -%}
      <div class="od-ev-grid" style="--od-cols: {{ count }};">
        {%- assign n = 0 -%}
        {%- for k in sorted -%}
          {%- if n >= count -%}{%- break -%}{%- endif -%}
          {%- assign parts = k | split: '::' -%}
          {%- if parts.size < 2 -%}{%- continue -%}{%- endif -%}
          {%- assign p = all_products[parts[1]] -%}
          {%- if p == blank -%}{%- continue -%}{%- endif -%}
          {%- include 'event-card', product: p -%}
          {%- assign n = n | plus: 1 -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="od-blog__empty">{{ 'events.none_upcoming' | t }}</p>
    {%- endif -%}
  </div>
</section>
{%- endif -%}
{%- endunless -%}

{% schema %}
{
  "name": "Upcoming events",
  "tag": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Events collection", "info": "Overrides Theme settings > Events. Leave empty to use that one." },
    { "type": "paragraph", "content": "Shows the next events (products of type Event in the events collection, Theme settings > Events). Empty when nothing is coming up." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Upcoming events" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "range", "id": "count", "label": "Events shown", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "text", "id": "btn1_label", "label": "Button 1 label", "default": "Upcoming events" },
    { "type": "url", "id": "btn1_url", "label": "Button 1 link (defaults to the events page)" },
    { "type": "text", "id": "btn2_label", "label": "Button 2 label", "default": "All events" },
    { "type": "url", "id": "btn2_url", "label": "Button 2 link (defaults to the events page, all tab)" },
    { "type": "color", "id": "bg", "label": "Background (empty = none)" },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#551c25" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#595b33" },
    { "type": "range", "id": "pad_top", "label": "Space above", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "pad_bottom", "label": "Space below", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 }
  ],
  "presets": [ { "name": "Upcoming events" } ]
}
{% endschema %}
