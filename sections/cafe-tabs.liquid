{%- comment -%}
  Cafe category tabs: generated in the browser from the Seasonal menu and Menu category sections on the page
  (assets/od-cafe.js). Sticky under the header, scroll sideways on mobile, jump to the section. Square corners.
{%- endcomment -%}
{%- assign st = section.settings -%}
<div class="od-cafe od-cafe-tabs" data-cafe-tabs style="--od-blk-bg: {{ st.bg }}; --od-blk-text: {{ st.text_color }}; --od-accent: {{ st.accent }}; --od-active-bg: {{ st.active_bg }}; --od-active-text: {{ st.active_text }};">
  <div class="_container_1kxnl_30">
    {%- if st.heading != blank -%}<p class="od-cafe-tabs__heading">{{ st.heading }}</p>{%- endif -%}
    <nav class="od-cafe-tabs__nav" data-cafe-tabs-nav aria-label="{{ st.heading | default: 'Menu' | escape }}"></nav>
  </div>
</div>
<script src="{{ 'od-cafe.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Cafe category tabs",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Tabs are created automatically from every \"Seasonal menu\" and \"Menu category\" section on this page, in page order (Seasonal first, in the accent colour)." },
    { "type": "text", "id": "heading", "label": "Heading above the tabs", "default": "Menu" },
    { "type": "color", "id": "bg", "label": "Bar background", "default": "#fcf8f2" },
    { "type": "color", "id": "text_color", "label": "Tab text / border", "default": "#182c29" },
    { "type": "color", "id": "active_bg", "label": "Active tab background", "default": "#182c29" },
    { "type": "color", "id": "active_text", "label": "Active tab text", "default": "#f0d58e" },
    { "type": "color", "id": "accent", "label": "Seasonal tab colour", "default": "#f0d58e" }
  ],
  "presets": [ { "name": "Cafe category tabs" } ]
}
{% endschema %}
