{%- comment -%}
  Top-right login popover (18 Oct 2026): one Sign in button to Shopify's hosted sign-in (email + one-time code), a
  "Create an account" link, the Circle card. The email field and the Google button of the old site are gone
  (Google is not connected on this store). return_to brings the customer back to /pages/my-account.
{%- endcomment -%}
{%- liquid
  assign rtl = false
  if request.locale.iso_code contains 'ar'
    assign rtl = true
  endif
-%}
<div class="_backdrop_9316i_30 _modalAddBackdropCls_111bg_231" data-modal-backdrop="login" data-show-class="_backdropShow_111bg_37"></div>
<div class="_modal_9316i_132 {% if rtl %}_modalAddClsRtl_111bg_195{% else %}_modalAddCls_111bg_195{% endif %}" data-modal="login" data-show-class="_show_111bg_30">
  <div class="_content_9316i_45">
    <div class="_globalImg_1tf1q_38 _close_111bg_71" data-close-modal="login"><img fetchpriority="auto" alt="{{ 'general.accessibility.close' | t }}" src="{{ 'icons_cross.svg' | asset_url }}"></div>
    <div class="_modalLogin_111bg_93">
      <div class="_globalImg_1tf1q_38 _mobileLogo_111bg_80"><img fetchpriority="auto" alt="{{ shop.name | escape }}" src="{{ 'icons_light_logo-sun.svg' | asset_url }}"></div>
      <h4>{{ 'customer.login.title' | t }}</h4>
      <div class="od-login">
        <p class="od-login__hello">{{ 'customer.login.welcome' | t }}</p>
        <p class="od-login__text">{{ 'customer.login.intro' | t }}</p>
        {%- comment -%} one link to Shopify's hosted sign-in (email + one-time code); return_to lands the customer on our My Account page {%- endcomment -%}
        <a href="{{ routes.account_login_url }}{% if routes.account_login_url contains '?' %}&{% else %}?{% endif %}return_to=/pages/my-account" class="_btn_lnddl_30 _modalLogin__button_111bg_191 od-login__btn" data-login-go>{{ 'customer.login.submit' | t }}</a>
        <p class="od-login__new">{{ 'customer.login.new_here' | t }} <a href="{{ routes.account_register_url }}" class="od-login__link">{{ 'customer.login.create' | t }}</a></p>
      </div>
      {%- render 'od-circle' -%}
    </div>
  </div>
</div>
