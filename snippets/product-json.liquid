{%- comment -%}
  JSON blob consumed by assets/od-card.js (product card + quick-add drawer).
  Params: product (required), color_name, short_desc, material (optional; computed here when missing),
          colour (round 9: the colour this card shows, for "one card per colour"), colour_variant (its variant id),
          media_map (optional, the map string below when the caller already computed it),
          format: 'map' outputs ONLY the media -> colour map string "|<media id>:<colour>|..." (colour empty = shared photo)
  Photo -> colour rule (same as the product page, theme.js initProduct): a photo belongs to a colour when it is the
  variant image of that colour, else when its alt text equals the colour or starts with the colour + separator
  (space - | : ,), case-insensitive. Photos with no colour show for every colour.
{%- endcomment -%}
{%- liquid
  if color_name == blank
    assign color_name = settings.color_option_name | default: 'Color'
  endif
  assign color_name_d = color_name | downcase | strip
  assign colour_opt = nil
  assign colour_pos = 0
  for opt in product.options_with_values
    assign on_d = opt.name | downcase | strip
    if on_d == color_name_d or on_d == 'color' or on_d == 'colour' or on_d == 'اللون' or on_d == 'لون'
      assign colour_opt = opt
      assign colour_pos = forloop.index
      assign color_name = opt.name
      break
    endif
  endfor
  assign colour_idx0 = colour_pos | minus: 1

  if media_map == blank
    assign media_map = '|'
    if colour_opt and colour_opt.values.size > 0
      for m in product.media limit: 10
        if m.media_type != 'image'
          continue
        endif
        assign mc = ''
        for v in product.variants
          if v.featured_media and v.featured_media.id == m.id
            assign mc = v.options[colour_idx0]
            break
          endif
        endfor
        if mc == ''
          assign alt_d = m.alt | downcase | strip
          if alt_d != ''
            for cv in colour_opt.values
              assign cv_d = cv | downcase | strip
              if cv_d == ''
                continue
              endif
              if alt_d == cv_d
                assign mc = cv
                break
              endif
              assign head = alt_d | slice: 0, cv_d.size
              if head == cv_d
                assign nxt = alt_d | slice: cv_d.size, 1
                if nxt == ' ' or nxt == '-' or nxt == '|' or nxt == ':' or nxt == ','
                  assign mc = cv
                  break
                endif
              endif
            endfor
          endif
        endif
        assign mc = mc | remove: '|' | remove: ':'
        assign media_map = media_map | append: m.id | append: ':' | append: mc | append: '|'
      endfor
    endif
  endif
-%}
{%- if format == 'map' -%}
{{- media_map -}}
{%- else -%}
{%- liquid
  if short_desc == blank
    assign short_desc = product.description | replace: '<br>', ' ' | replace: '<br/>', ' ' | replace: '<br />', ' ' | replace: '</p>', ' ' | replace: '</li>', ' ' | strip_html | strip_newlines | strip | truncate: 300
  endif
  if material == blank
    assign material = product.metafields.custom.material.value | strip_html
  endif
-%}
  <script type="application/json" data-card-json>
  {
    "id": {{ product.id | json }},
    "handle": {{ product.handle | json }},
    "title": {{ product.title | json }},
    "url": {{ product.url | json }},
    "vendor": {{ product.vendor | json }},
    "price": {{ product.price | json }},
    "compare_at_price": {{ product.compare_at_price | json }},
    "options": [{% for opt in product.options_with_values %}{"name":{{ opt.name | json }},"values":{{ opt.values | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}],
    "color": {{ color_name | json }},
    "colour": {% if colour != blank %}{{ colour | json }}{% else %}null{% endif %},
    "colour_variant": {% if colour_variant != blank %}{{ colour_variant | json }}{% else %}null{% endif %},
    "swatches": {% assign sw_n = 0 %}{% assign sw_lb = '{' %}{% assign sw_rb = '}' %}{{ sw_lb }}{% if colour_opt %}{% for value in colour_opt.values %}{% if sw_n > 0 %},{% endif %}{% assign sw_n = sw_n | plus: 1 %}{{ value | json }}:{% capture sw_css %}{% render 'swatch-color', value: value %}{% endcapture %}{{ sw_css | strip | json }}{% endfor %}{% endif %}{{ sw_rb }},
    "single": {{ product.has_only_default_variant | json }},
    "images": [{% assign n = 0 %}{% for m in product.media %}{% if m.media_type == 'image' and n < 6 %}{% if n > 0 %},{% endif %}{"src":{{ m | image_url: width: 600 | json }},"alt":{{ m.alt | default: product.title | json }}}{% assign n = n | plus: 1 %}{% endif %}{% endfor %}],
    "media": [{% assign n = 0 %}{% for m in product.media limit: 10 %}{% if m.media_type == 'image' %}{% if n > 0 %},{% endif %}{% assign n = n | plus: 1 %}{% assign mkey = '|' | append: m.id | append: ':' %}{% assign mcol = '' %}{% if media_map contains mkey %}{% assign mcol = media_map | split: mkey | last | split: '|' | first | default: '' %}{% endif %}{"id":{{ m.id | json }},"src":{{ m | image_url: width: 600 | json }},"alt":{{ m.alt | default: '' | json }},"colour":{% if mcol != '' %}{{ mcol | json }}{% else %}null{% endif %}}{% endif %}{% endfor %}],
    "variants": [{% for v in product.variants %}{"id":{{ v.id | json }},"title":{{ v.title | json }},"option1":{{ v.option1 | json }},"option2":{{ v.option2 | json }},"option3":{{ v.option3 | json }},"available":{{ v.available | json }},"price":{{ v.price | json }},"compare_at_price":{{ v.compare_at_price | json }},"image":{% if v.featured_image %}{{ v.featured_image | image_url: width: 600 | json }}{% else %}null{% endif %},"media_id":{% if v.featured_media %}{{ v.featured_media.id | json }}{% else %}null{% endif %},"qty":{{ v.inventory_quantity | default: 0 | json }},"tracked":{% if v.inventory_management != blank %}true{% else %}false{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}],
    "badges": {% render 'product-badges', product: product, limit: 2, format: 'json' %},
    "available": {{ product.available | json }},
    "description": {{ short_desc | json }},
    "material": {% if material != blank %}{{ material | json }}{% else %}null{% endif %}
  }
</script>
{%- endif -%}
