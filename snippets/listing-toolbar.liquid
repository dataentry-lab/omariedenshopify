{%- comment -%}
  Listing toolbar (collection and search pages).
  Desktop: [Filter] [Sort by] ............ [category buttons]
  Mobile:  category buttons (scrollable row), then a sticky Filter / Sort by row.
  Params: sort_by, is_search, stay (19 Nov 2026: data line of snippets/stay-nav on collections that keep their categories inside, else empty)
  Desktop grid toggle 4 / 5 per row (remembered for the session, assets/od-listing.js); mobile is always 2.
  Sort / filter / categories load results without a page reload; the "Updating" spinner shows meanwhile.
{%- endcomment -%}
{%- liquid
  assign rtl = false
  if request.locale.iso_code contains 'ar'
    assign rtl = true
  endif
  assign sort_label = 'listing.sort_by' | t
  case sort_by
    when 'best-selling'
      assign sort_label = 'collections.sort.best_selling' | t
    when 'created-descending'
      assign sort_label = 'collections.sort.newest' | t
    when 'price-ascending'
      assign sort_label = 'collections.sort.price_asc' | t
    when 'price-descending'
      assign sort_label = 'collections.sort.price_desc' | t
    when 'title-ascending'
      assign sort_label = 'collections.sort.brand' | t
  endcase
  assign lim_on = false
  if settings.lim_listing != false and is_search != true and collection.handle != blank
    assign lim_hs = settings.lim_listing_collections | newline_to_br | split: '<br />'
    for h in lim_hs
      assign hh = h | strip | downcase
      if hh != '' and hh == collection.handle or hh == 'all'
        assign lim_on = true
      endif
    endfor
  endif
-%}
{%- comment -%}
  21 Nov 2026: "Limited availability" note under Filter / Sort by, with a short one-line strip while the row is pinned.
  Theme settings > Limited availability note: lim_listing (on / off) + lim_listing_collections (handles, one per line; "all" = every collection).
  Printed twice: --m inside the pinned Filter row (phones), --d as a row of the pinned toolbar (tablet + desktop).
{%- endcomment -%}
{%- comment -%}
  26 Nov 2026: Sale filter and colour cards. Runs before the grid paints: when filter.p.tag=sale:NN is in the address,
  cards whose own percent (data-sale-pct) is not NN are hidden. Same code as saleCardsSync() in assets/od-listing.js.
{%- endcomment -%}
{%- if settings.sale_filter_cards != false -%}
<script>(function(){try{var n='';new URLSearchParams(location.search).getAll('filter.p.tag').forEach(function(v){var m=/^sale:(\d{1,3})$/.exec(v);if(m)n+=':not([data-sale-pct="'+m[1]+'"])';});var s=document.getElementById('od-sale-cards');if(!s){s=document.createElement('style');s.id='od-sale-cards';document.head.appendChild(s);}s.textContent=n?'[data-product-grid] [data-od-card][data-sale-pct]'+n+'{display:none!important}':'';}catch(e){}})();</script>
{%- endif -%}
{%- capture lim_inner -%}{% render 'icon-clock' %}<span><b>{{ 'cart.limited.title' | t }}</b> <span class="od-listing__lim-full">{{ 'cart.limited.text' | t }}</span><span class="od-listing__lim-short">{{ 'cart.limited.short' | t }}</span></span>{%- endcapture -%}
<div class="od-listing__toolbar{% if is_search %} od-listing__toolbar--search{% endif %}{% if lim_on %} od-listing__toolbar--lim{% endif %}" data-listing-toolbar>
  {%- render 'listing-categories', is_search: is_search, stay: stay -%}
  <div class="od-listing__sentinel" data-listing-sentinel aria-hidden="true"></div>
  <div class="od-listing__controls" data-listing-controls>
    <div class="od-listing__control">
      <button type="button" class="_filterButtonWithIcon_1xi50_34 od-listing__filter" data-open-modal="filter" aria-haspopup="dialog">
        <span>{{ 'collections.filter.button' | t }}</span>
        <div class="_globalImg_1tf1q_38 _fIcon_1xi50_74"><img fetchpriority="auto" alt="" width="16" height="16" src="{{ 'icons_light_filter.svg' | asset_url }}"></div>
      </button>
    </div>
    <div class="od-listing__control">
      <div class="_form_control_9l1c3_30">
        <div class="_select_box_9l1c3_51 _sortby_13mii_101 od-listing__sort" data-select data-sort-select role="button" tabindex="0" aria-haspopup="listbox">
          <span class="{% if sort_by %}_value_9l1c3_91{% else %}_placeholder_9l1c3_76{% endif %}" data-select-label>{{ sort_label }}</span>
          <div class="_globalImg_1tf1q_38 _arrow_9l1c3_68"><img fetchpriority="auto" alt="" width="16" height="16" src="{% if rtl %}{{ 'icons_light_arrow_left.svg' | asset_url }}{% else %}{{ 'icons_light_arrow_right.svg' | asset_url }}{% endif %}"></div>
        </div>
        <ul class=" _optionCls_13mii_160 _options_9l1c3_126 _options_bottom_9l1c3_221" data-select-options hidden>
          <li data-value="best-selling">{{ 'collections.sort.best_selling' | t }}</li>
          <li data-value="created-descending">{{ 'collections.sort.newest' | t }}</li>
          <li data-value="price-ascending">{{ 'collections.sort.price_asc' | t }}</li>
          <li data-value="price-descending">{{ 'collections.sort.price_desc' | t }}</li>
        </ul>
      </div>
    </div>
    <div class="od-listing__cols" role="group" aria-label="{{ 'listing.grid' | t }}">
      {%- comment -%} round 9: the original dot icons (a row of 4 / 5 dots), no box {%- endcomment -%}
      <button type="button" data-grid-cols="4" class="is-active" aria-pressed="true" aria-label="{{ 'listing.grid_4' | t }}"><svg viewBox="0 0 36 6" width="36" height="6" aria-hidden="true"><g fill="currentColor"><circle cx="3" cy="3" r="3"/><circle cx="13" cy="3" r="3"/><circle cx="23" cy="3" r="3"/><circle cx="33" cy="3" r="3"/></g></svg></button>
      <button type="button" data-grid-cols="5" aria-pressed="false" aria-label="{{ 'listing.grid_5' | t }}"><svg viewBox="0 0 46 6" width="46" height="6" aria-hidden="true"><g fill="currentColor"><circle cx="3" cy="3" r="3"/><circle cx="13" cy="3" r="3"/><circle cx="23" cy="3" r="3"/><circle cx="33" cy="3" r="3"/><circle cx="43" cy="3" r="3"/></g></svg></button>
    </div>
    <span class="od-listing__updating" aria-live="polite"><i aria-hidden="true"></i>{{ 'listing.updating' | t }}</span>
    {%- if lim_on -%}<div class="od-po-note od-lim-note od-listing__lim od-listing__lim--m">{{ lim_inner }}</div>{%- endif -%}
  </div>
  {%- if lim_on -%}<div class="od-po-note od-lim-note od-listing__lim od-listing__lim--d" aria-hidden="true">{{ lim_inner }}</div>{%- endif -%}
</div>

{%- comment -%} round 10: active filter chips (one per applied value + price range) with x to remove, and Clear all {%- endcomment -%}
{%- liquid
  if is_search
    assign results = search
  else
    assign results = collection
  endif
  assign active_n = 0
  for f in results.filters
    if f.type == 'price_range'
      if f.min_value.value != nil or f.max_value.value != nil
        assign active_n = active_n | plus: 1
      endif
    else
      assign active_n = active_n | plus: f.active_values.size
    endif
  endfor
  if is_search
    assign clear_url = search.terms | url_encode | prepend: '?q=' | prepend: routes.search_url
    if sort_by
      assign clear_url = clear_url | append: '&sort_by=' | append: sort_by
    endif
  else
    assign clear_url = collection.url
    if stay != blank
      assign stay0 = stay | split: '@@' | first | split: '~~'
      assign clear_url = stay0[2]
    endif
    if sort_by
      if clear_url contains '?'
        assign clear_url = clear_url | append: '&sort_by=' | append: sort_by
      else
        assign clear_url = clear_url | append: '?sort_by=' | append: sort_by
      endif
    endif
  endif
-%}
{%- comment -%} 19 Nov 2026: always printed (hidden when empty) so od-listing.js can add the Sale chips on languages where Shopify returns no tag filter {%- endcomment -%}
{%- if true -%}
<div class="od-listing__active" data-listing-active data-listing-ajax aria-label="{{ 'listing.active_filters' | t }}"{% if active_n == 0 %} hidden{% endif %}>
  {%- for f in results.filters -%}
    {%- if f.type == 'price_range' -%}
      {%- if f.min_value.value != nil or f.max_value.value != nil -%}
        {%- assign pmin = f.min_value.value | default: 0 -%}
        {%- assign pmax = f.max_value.value | default: f.range_max -%}
        <a class="od-chipx" href="{{ f.url_to_remove }}" aria-label="{{ 'listing.remove_filter' | t: name: f.label }}"><span class="od-chipx__t">{% render 'sar' %}{{ pmin | money_without_currency }} &ndash; {% render 'sar' %}{{ pmax | money_without_currency }}</span><span class="od-chipx__x" aria-hidden="true">&times;</span></a>
      {%- endif -%}
    {%- else -%}
      {%- for v in f.active_values -%}
        {%- assign vl = v.label -%}
        {%- assign vhead = v.value | downcase | slice: 0, 5 -%}
        {%- if f.param_name == 'filter.p.tag' and vhead == 'sale:' -%}
          {%- assign pn = v.value | downcase | remove: 'sale:' -%}
          {%- assign vl = 'collections.filter.percent_off' | t: n: pn -%}
        {%- elsif f.param_name == 'filter.p.tag' and v.value == 'extra-20' -%}
          {%- assign vl = 'collections.filter.extra_20' | t -%}
        {%- elsif vl.size <= 3 -%}{%- assign vl = f.label | append: ' ' | append: v.label -%}{%- endif -%}
        <a class="od-chipx" href="{{ v.url_to_remove }}" aria-label="{{ 'listing.remove_filter' | t: name: v.label }}"><span class="od-chipx__t">{{ vl }}</span><span class="od-chipx__x" aria-hidden="true">&times;</span></a>
      {%- endfor -%}
    {%- endif -%}
  {%- endfor -%}
  <a class="od-listing__clear" href="{{ clear_url }}">{{ 'listing.clear_all' | t }}</a>
</div>
{%- endif -%}
