{%- comment -%}
  Notify me box (16 Nov 2026): the note, the email field for guests and the "You are on the list" state.
  Used by sections/main-product.liquid and snippets/quick-add-drawer.liquid. Hidden until assets/od-notify.js shows it
  for a sold-out size. Signed-in customers get no email field (their account email is used).
  The fields have NO name on purpose: they sit inside the product form and must not travel with add to cart.
  Params: qa (true inside the quick view drawer).
{%- endcomment -%}
<div class="od-nm{% if qa %} od-nm--qa{% endif %}" data-nm hidden>
  <div data-nm-ask>
    <div class="od-po-note od-nm__note">
      <svg class="od-po-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 16.5V11a6 6 0 0 1 12 0v5.5l1.5 2h-15zM10 20.5a2 2 0 0 0 4 0" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span data-nm-text></span>
    </div>
    {%- unless customer -%}
      <input type="email" class="od-nm__email" data-nm-email inputmode="email" autocomplete="email" autocapitalize="off" autocorrect="off" spellcheck="false" placeholder="{{ 'products.notify.email_placeholder' | t | escape }}" aria-label="{{ 'products.notify.email_placeholder' | t | escape }}">
      <input type="text" class="od-nm__hp" data-nm-hp tabindex="-1" autocomplete="off" aria-hidden="true">
    {%- endunless -%}
    <p class="od-nm__err" data-nm-err role="alert" hidden></p>
  </div>
  <div class="od-po-note od-nm__note od-nm__done" data-nm-done hidden>
    <svg class="od-po-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <span><b>{{ 'products.notify.done_title' | t }}</b> <span data-nm-done-text></span></span>
  </div>
</div>
