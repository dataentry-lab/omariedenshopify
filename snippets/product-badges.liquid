{%- comment -%}
  Product badges, driven by the product itself (Theme settings > Product badges).
  Rules are checked top to bottom, first matches win, at most `limit` badges (default 2).
    1. custom.badge metafield text (always first when enabled)
    2. rules 1..6: tag / collection match, automatic New (published within N days), automatic Sale
  Sold out is handled by the caller (it replaces every other badge).
  Params: product (required), limit (default 2), format: 'html' (default) or 'json',
          price + compare (optional, in cents): the price pair of the card / selected size. 18 Nov 2026: the Sale
          badge follows THIS pair (a product can hold sizes at -50%, -60% and full price at once), not the product tag.
  Used by: product-card, product-json, quick-add, product page gallery.
{%- endcomment -%}
{%- liquid
  assign limit = limit | default: 2
  assign format = format | default: 'html'
  assign is_ar = false
  if request.locale.iso_code contains 'ar'
    assign is_ar = true
  endif

  assign haystack = '|'
  for tag in product.tags
    assign t = tag | downcase | strip
    assign haystack = haystack | append: t | append: '|'
  endfor
  for c in product.collections
    assign haystack = haystack | append: c.handle | append: '|'
  endfor

  assign now_s = 'now' | date: '%s' | plus: 0
  assign pub_s = product.published_at | date: '%s' | plus: 0
  assign age_days = now_s | minus: pub_s | divided_by: 86400

  assign s_price = product.price
  assign s_compare = product.compare_at_price | default: 0
  assign s_base = product.selected_or_first_available_variant
  if s_base
    assign s_price = s_base.price
    assign s_compare = s_base.compare_at_price | default: 0
  endif
  if price != blank
    assign s_price = price
    assign s_compare = compare | default: 0
  endif
  assign sale_idx = -1

  assign labels = ''
  assign bgs = ''
  assign texts = ''
  assign count = 0

  comment
    10 Nov 2026: pre-order badge (snippets/preorder-data.liquid), always first, brand maroon
  endcomment
  capture po_flag
    render 'preorder-data', product: product, format: 'flag'
  endcapture
  assign po_flag = po_flag | strip
  if po_flag == 'on'
    assign po_label = 'products.preorder.badge' | t
    assign labels = labels | append: po_label | append: '||'
    assign bgs = bgs | append: '#551c25' | append: '||'
    assign texts = texts | append: '#fcf8f2' | append: '||'
    assign count = count | plus: 1
  endif

  if settings.badge_metafield_enabled and count < limit
    assign mf = product.metafields.custom.badge.value
    if mf != blank
      assign labels = labels | append: mf | strip | append: '||'
      assign bgs = bgs | append: settings.badge_metafield_bg | append: '||'
      assign texts = texts | append: settings.badge_metafield_text | append: '||'
      assign count = count | plus: 1
    endif
  endif

  for i in (1..6)
    if count >= limit
      break
    endif
    assign key_type = 'badge_' | append: i | append: '_type'
    assign rtype = settings[key_type]
    if rtype == blank or rtype == 'none'
      continue
    endif
    assign key_match = 'badge_' | append: i | append: '_match'
    assign key_label = 'badge_' | append: i | append: '_label'
    assign key_label_ar = 'badge_' | append: i | append: '_label_ar'
    assign key_bg = 'badge_' | append: i | append: '_bg'
    assign key_text = 'badge_' | append: i | append: '_text'
    assign hit = false
    assign is_sale_rule = false
    assign label = settings[key_label]
    if is_ar and settings[key_label_ar] != blank
      assign label = settings[key_label_ar]
    endif

    if rtype == 'tags'
      assign tokens = settings[key_match] | default: '' | downcase | split: ','
      for tok in tokens
        assign tk = tok | strip
        if tk == blank
          continue
        endif
        assign needle = '|' | append: tk | append: '|'
        if haystack contains needle
          assign hit = true
          break
        endif
      endfor
    elsif rtype == 'new'
      assign days = settings.badge_new_days | default: 30
      if product.published_at != blank and age_days <= days
        assign hit = true
      endif
    elsif rtype == 'sale'
      if s_compare > s_price
        assign hit = true
        assign is_sale_rule = true
        if settings.badge_sale_style == 'percent'
          comment
            18 Nov 2026: the percentage comes from the price pair itself, the card colour or the selected size.
            The sale tag is only the fallback when the pair gives nothing. One product can carry two sale tags.
          endcomment
          assign pct_f = s_compare | minus: s_price | times: 100.0 | divided_by: s_compare
          assign pct = pct_f | round
          comment
            19 Nov 2026: sale prices are rounded to whole riyals, so 18 against 59 printed 69 for a discount of 70.
            The number snaps to the nearest step of 10, else of 5, when the gap is no more than that rounding
            can cause: half a riyal of the before price, plus half a point.
          endcomment
          assign pct_tol = 5000.0 | divided_by: s_compare | plus: 0.5
          assign pct_10 = pct_f | divided_by: 10.0 | round | times: 10
          assign pct_5 = pct_f | divided_by: 5.0 | round | times: 5
          assign dev_10 = pct_f | minus: pct_10 | abs
          assign dev_5 = pct_f | minus: pct_5 | abs
          if dev_10 <= pct_tol and pct_10 > 0 and pct_10 < 100
            assign pct = pct_10
          elsif dev_5 <= pct_tol and pct_5 > 0 and pct_5 < 100
            assign pct = pct_5
          endif
          if pct < 1
            for tag in product.tags
              assign tl = tag | downcase | strip
              if tl contains 'sale:'
                assign pct = tl | split: ':' | last | strip
                break
              endif
            endfor
          endif
          assign label = '-' | append: pct | append: '%'
        endif
      endif
    endif

    comment
      26 Oct 2026: the same label from two rules (tag "new" + automatic New) showed twice; a label already collected is skipped
    endcomment
    if hit and label != blank
      assign dup_needle = '||' | append: label | append: '||'
      assign dup_hay = '||' | append: labels
      if dup_hay contains dup_needle
        assign hit = false
      endif
    endif
    if hit and label != blank
      if is_sale_rule
        assign sale_idx = count
      endif
      assign labels = labels | append: label | append: '||'
      assign bgs = bgs | append: settings[key_bg] | append: '||'
      assign texts = texts | append: settings[key_text] | append: '||'
      assign count = count | plus: 1
    endif
  endfor

  assign label_arr = labels | split: '||'
  assign bg_arr = bgs | split: '||'
  assign text_arr = texts | split: '||'
-%}
{%- if format == 'json' -%}
  [{%- for l in label_arr -%}{%- if l == blank -%}{%- continue -%}{%- endif -%}{%- unless forloop.first -%},{%- endunless -%}{"label":{{ l | json }},{%- if forloop.index0 == sale_idx -%}"sale":true,{%- endif -%}"bg":{{ bg_arr[forloop.index0] | default: '#551c25' | json }},"text":{{ text_arr[forloop.index0] | default: '#ffffff' | json }}}{%- endfor -%}]
{%- else -%}
  {%- for l in label_arr -%}
    {%- if l == blank -%}{%- continue -%}{%- endif -%}
    <span class="od-card__badge"{% if forloop.index0 == sale_idx %} data-badge-sale{% endif %} style="background-color: {{ bg_arr[forloop.index0] | default: '#551c25' }}; color: {{ text_arr[forloop.index0] | default: '#ffffff' }};">{{ l }}</span>
  {%- endfor -%}
{%- endif -%}
