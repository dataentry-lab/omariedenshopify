{%- comment -%}
  Listing title (collection + search results pages).
  Params:
    title   – heading text (already escaped by the caller if needed)
    count   – number rendered as "(count)" next to the title (optional)
    eyebrow – small uppercase label above the title (optional)
    quoted  – true wraps the title in quotes (search page)
{%- endcomment -%}
{%- liquid
  assign rtl = false
  if request.locale.iso_code contains 'ar'
    assign rtl = true
  endif
-%}
<div class="od-listing__title">
  {%- if eyebrow != blank -%}
    <p class="od-listing__eyebrow">{{ eyebrow }}</p>
  {%- endif -%}
  {%- comment -%} round 11: on mobile the title splits at " - " (one segment per line, font fitted by od-listing.js);
      the count sits on the first line there and after the whole title on desktop {%- endcomment -%}
  {%- assign segs = title | split: ' - ' -%}
  <h1 class="od-listing__heading{% if rtl %} od-listing__heading--rtl{% endif %}{% if segs.size > 1 %} od-listing__heading--split{% endif %}" data-listing-title>
    <span class="od-listing__name">
      {%- if quoted -%}&ldquo;{{ title }}&rdquo;{%- else -%}
        {%- for seg in segs -%}
          <span class="od-listing__seg">{{ seg | strip }}{% if forloop.first and count != blank %} <span class="od-listing__count od-listing__count--m">({{ count }})</span>{% endif %}</span>
          {%- unless forloop.last %}<span class="od-listing__sep"> - </span>{% endunless -%}
        {%- endfor -%}
      {%- endif -%}
    </span>
    {%- if count != blank -%}
      <span class="od-listing__count od-listing__count--d">({{ count }})</span>
    {%- endif -%}
  </h1>
</div>
