{%- comment -%} Coming Soon (store password page). Figma 00_Coming Soon, desktop + mobile. Section: sections/main-password.liquid {%- endcomment -%}
{%- liquid
  assign rtl = false
  if request.locale.iso_code contains 'ar'
    assign rtl = true
  endif
-%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}"{% if rtl %} dir="rtl"{% endif %}>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="{{ 'icons_omariden.svg' | asset_url }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{{ shop.name }} &ndash; {{ 'password.coming_soon' | t }}</title>
    <meta name="description" content="{{ shop.description | default: shop.name | escape }}">
    {{ content_for_header }}
    <link rel="preload" as="font" href="{{ 'bricolage.ttf' | asset_url }}" type="font/ttf" crossorigin>
    <link rel="preload" as="font" href="{{ 'Basteleur-Moonlight.otf' | asset_url }}" type="font/otf" crossorigin>
    {{ 'omarieden.css' | asset_url | stylesheet_tag }}
    {{ 'od-password.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="od-pw-body{% if rtl %} od-pw-body--rtl{% endif %}">
    {{ content_for_layout }}
    <script src="{{ 'od-password.js' | asset_url }}" defer></script>
  </body>
</html>
