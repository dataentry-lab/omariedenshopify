{%- liquid
  assign rtl = false
  if request.locale.iso_code contains 'ar'
    assign rtl = true
  endif
  assign dark_header = false
  case request.page_type
    when 'index', 'list-collections'
      assign dark_header = true
    when 'page'
      if template.suffix == 'about' or template.suffix == 'contact' or template.suffix == 'faqs' or template.suffix == 'policy'
        assign dark_header = true
      endif
  endcase
-%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="UTF-8">
    {%- comment -%} /collections/all is Shopify's system collection with no admin sort setting: open it newest first (round 12). Runs before paint, so no flash. {%- endcomment -%}
    {%- if template.name == 'collection' and collection.handle == 'all' and collection.sort_by == blank -%}
    <script>(function(){var u=new URL(location.href);if(!u.searchParams.get('sort_by')){u.searchParams.set('sort_by','created-descending');location.replace(u.toString());}})();</script>
    {%- endif -%}
    {%- comment -%} /collections (Shopify's all-collections list) is not used: send visitors to the full catalogue and keep it out of search engines (client, 22 Oct 2026). {%- endcomment -%}
    {%- if template.suffix == 'my-account' -%}
    {%- comment -%} themed My Account retired 22 Oct 2026, Shopify's hosted account pages are the only account UI {%- endcomment -%}
    <meta name="robots" content="noindex, nofollow">
    <script>location.replace({{ routes.account_url | json }});</script>
    {%- endif -%}
    {%- if template.name == 'list-collections' -%}
    <meta name="robots" content="noindex, nofollow">
    <meta http-equiv="refresh" content="0; url={{ routes.all_products_collection_url }}?sort_by=created-descending">
    <script>location.replace({{ routes.all_products_collection_url | append: '?sort_by=created-descending' | json }});</script>
    {%- endif -%}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <link rel="icon" type="image/svg+xml" href="{{ 'icons_omariden.svg' | asset_url }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>
      {{- page_title -}}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    {%- if settings.head_verification != blank -%}{{ settings.head_verification }}{%- endif -%}
    {{ content_for_header }}

    <link rel="preload" as="font" href="{{ 'bricolage.ttf' | asset_url }}" type="font/ttf" crossorigin>
    <link rel="preload" as="font" href="{{ 'Basteleur-Moonlight.otf' | asset_url }}" type="font/otf" crossorigin>
    {%- if rtl -%}
      <link rel="preload" as="font" href="{{ 'IBMPlexArabic-Regular.otf' | asset_url }}" type="font/otf" crossorigin>
    {%- endif -%}
    {{ 'omarieden.css' | asset_url | stylesheet_tag }}
    {{ 'theme-shopify.css' | asset_url | stylesheet_tag }}
    {{ 'od-round9.css' | asset_url | stylesheet_tag }}
    {{ 'od-card.css' | asset_url | stylesheet_tag }}
    {{ 'od-cart.css' | asset_url | stylesheet_tag }}
    {{ 'od-menu.css' | asset_url | stylesheet_tag }}
    {{ 'od-listing.css' | asset_url | stylesheet_tag }}
    {{ 'od-blocks.css' | asset_url | stylesheet_tag }}

    <script>
      window.OD = {
        rtl: {{ rtl | json }},
        locale: {{ request.locale.iso_code | json }},
        rootUrl: {{ routes.root_url | json }},
        cartUrl: {{ routes.cart_url | json }},
        cartAddUrl: {{ routes.cart_add_url | json }},
        cartChangeUrl: {{ routes.cart_change_url | json }},
        cartUpdateUrl: {{ routes.cart_update_url | json }},
        searchUrl: {{ routes.search_url | json }},
        predictiveSearchUrl: {{ routes.predictive_search_url | json }},
        accountUrl: {{ routes.account_url | json }},
        loginUrl: {{ routes.account_login_url | json }},
        collectionsUrl: {{ routes.collections_url | json }},
        allProductsUrl: {{ routes.all_products_collection_url | json }},
        customerId: {{ customer.id | json }},
        cartCount: {{ cart.item_count }},
        freeShippingThreshold: {{ settings.free_shipping_threshold | default: 500 }},
        moneyFormat: {{ shop.money_format | json }},
        colorOptionName: {{ settings.color_option_name | default: 'Color' | json }},
        galleryColorMode: {{ settings.gallery_color_mode | default: 'filter' | json }},
        swatchMap: {{ settings.color_swatch_map | json }},
        cardPerColour: {% if settings.card_per_colour == false %}false{% else %}true{% endif %},
        multiSwatchImage: {% if settings.multi_swatch_image != blank %}{{ settings.multi_swatch_image | image_url: width: 80 | json }}{% else %}null{% endif %},
        preorder: {% if settings.preorder_enabled == false %}false{% else %}{ badge: {{ 'products.preorder.badge' | t | json }}, button: {{ 'products.preorder.button' | t | json }}, note: {{ 'products.preorder.note' | t: text: '__TEXT__' | json }}, ready: {{ 'products.preorder.when_ready' | t | json }}, noteReady: {{ 'products.preorder.note_ready' | t | json }}, sub: {{ 'products.preorder.pay_today' | t | json }}, label: {{ 'products.preorder.badge' | t | json }}, mixed: {{ settings.preorder_mixed_note | json }} }{% endif %},
        notify: {% if settings.notify_mode == 'off' or settings.notify_endpoint == blank %}false{% else %}{ url: {{ settings.notify_endpoint | json }}, all: {% if settings.notify_mode == 'all' %}true{% else %}false{% endif %}, email: {{ customer.email | json }}, t: { soldSize: {{ 'products.notify.sold_size' | t: size: '__SIZE__' | json }}, soldPiece: {{ 'products.notify.sold_piece' | t | json }}, soonSize: {{ 'products.notify.soon_size' | t: size: '__SIZE__' | json }}, soonPiece: {{ 'products.notify.soon_piece' | t | json }}, askGuest: {{ 'products.notify.ask_guest' | t | json }}, askSigned: {{ 'products.notify.ask_signed' | t: email: '__EMAIL__' | json }}, doneText: {{ 'products.notify.done_text' | t: email: '__EMAIL__' | json }}, emailError: {{ 'products.notify.email_error' | t | json }}, error: {{ 'products.notify.error' | t | json }}, available: {{ 'products.notify.available' | t | json }}, rate: {{ 'products.notify.rate' | t | json }} } }{% endif %},
        currency: {% if settings.cur_enabled == false %}false{% else %}{ rates: {{ settings.cur_rates | json }}, country: {{ localization.country.iso_code | json }}, auto: {% if settings.cur_auto == false %}false{% else %}true{% endif %}, aboutCards: {% if settings.cur_about_cards %}true{% else %}false{% endif %}, t: { about: {{ 'currency.about' | t | json }}, sar: {{ 'currency.sar_amount' | t | json }} } }{% endif %},
        sizeT: {% if settings.size_guide_enabled == false %}false{% else %}{ picked: {{ 'products.size_guide.picked' | t | json }}, scope: {{ 'products.size_guide.scope' | t | json }}, label_col: {{ 'products.size_guide.on_label' | t | json }}, label_hint: {{ 'products.size_guide.label_hint' | t | json }}, unit_cm: {{ 'products.size_guide.unit_cm' | t | json }}, unit_in: {{ 'products.size_guide.unit_in' | t | json }} }{% endif %},
        badges: {
          metafield: {{ settings.badge_metafield_enabled | json }},
          newDays: {{ settings.badge_new_days | default: 30 }},
          saleStyle: {{ settings.badge_sale_style | default: 'label' | json }},
          soldOut: {{ settings.badge_soldout_enabled | json }},
          soldOutLabel: {{ 'products.product.sold_out' | t | json }},
          comingSoonLabel: {{ 'products.product.coming_soon' | t | json }},
          rules: [
            {%- for i in (1..6) -%}
              {%- assign kt = 'badge_' | append: i | append: '_type' -%}
              {%- assign km = 'badge_' | append: i | append: '_match' -%}
              {%- assign kl = 'badge_' | append: i | append: '_label' -%}
              {%- assign kla = 'badge_' | append: i | append: '_label_ar' -%}
              {%- assign kb = 'badge_' | append: i | append: '_bg' -%}
              {%- assign kx = 'badge_' | append: i | append: '_text' -%}
              {%- assign lbl = settings[kl] -%}
              {%- if rtl and settings[kla] != blank -%}{%- assign lbl = settings[kla] -%}{%- endif -%}
              { type: {{ settings[kt] | default: 'none' | json }}, match: {{ settings[km] | default: '' | json }}, label: {{ lbl | default: '' | json }}, bg: {{ settings[kb] | default: '#551c25' | json }}, text: {{ settings[kx] | default: '#ffffff' | json }} }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        },
        assets: {
          wishlist: {{ 'icons_light_wishlist.svg' | asset_url | json }},
          wishlistFilled: {{ 'icons_light_favourite.svg' | asset_url | json }},
          arrowRight: {{ 'icons_light_arrow_right.svg' | asset_url | json }},
          arrowLeft: {{ 'icons_light_arrow_left.svg' | asset_url | json }},
          plus: {{ 'icons_light_plus.svg' | asset_url | json }},
          minus: {{ 'icons_light_minus.svg' | asset_url | json }},
          fallback: {{ 'images_fallback.svg' | asset_url | json }}
        },
        t: {
          addedToCart: {{ 'products.product.added_to_cart' | t | json }},
          addedToWishlist: {{ 'wishlist.added' | t | json }},
          removedFromWishlist: {{ 'wishlist.removed' | t | json }},
          cartError: {{ 'cart.general.error' | t | json }},
          viewResults: {{ 'search.view_results' | t | json }},
          suggestion: {{ 'search.suggestion' | t | json }},
          products: {{ 'search.products' | t | json }},
          noResults: {{ 'search.no_results' | t | json }},
          shippingUnlocked: {{ 'cart.shipping.unlocked' | t | json }},
          shippingRemaining: {{ 'cart.shipping.remaining_html' | t | json }}
        }
      };
      document.documentElement.className += ' js';
      (function(){var c=window.OD.currency;if(!c)return;var m={SA:'SAR',AE:'AED',BH:'BHD',KW:'KWD',OM:'OMR',QA:'QAR',JO:'JOD',EG:'EGP',US:'USD',GB:'GBP'},r={},cur=null;String(c.rates||'').split(/\n/).forEach(function(l){var p=l.split('='),k=(p[0]||'').trim().toUpperCase(),v=parseFloat(p[1]);if(/^[A-Z]{3}$/.test(k)&&v>0)r[k]=v;});c.map=r;try{cur=localStorage.getItem('od_currency');}catch(e){}if(!cur||(cur!=='SAR'&&!r[cur]))cur=m[c.country]||'SAR';if(cur!=='SAR'&&!r[cur])cur='SAR';c.now=cur;var h=document.documentElement;h.setAttribute('data-od-cur',cur);if(cur!=='SAR')h.className+=' od-cur-wait';})();
    </script>
  </head>

  <body class="template-{{ request.page_type | handle }}{% if template.suffix %} template-{{ request.page_type | handle }}-{{ template.suffix | handle }}{% endif %}" {% if rtl %}dir="rtl"{% endif %} data-dark-header="{{ dark_header }}">
    {%- if settings.body_start_scripts != blank -%}{{ settings.body_start_scripts }}{%- endif -%}
    <div id="root">
      {%- sections 'header-group' -%}
      <main id="MainContent">
        {%- comment -%} no breadcrumbs on the home page or on pages with the transparent header (about, contact, faqs), client 7 Sep {%- endcomment -%}
        {%- unless request.page_type == 'index' or request.page_type == 'password' or request.page_type == '404' or dark_header -%}
          {%- liquid
            assign crumbs_overlay = false
            if request.page_type == 'blog' or request.page_type == 'article'
              assign crumbs_overlay = true
            elsif request.page_type == 'page' and template.suffix != blank and template.suffix != 'brands' and template.suffix != 'legal' and template.suffix != 'wishlist' and template.suffix != 'activation'
              assign crumbs_overlay = true
            elsif request.page_type == 'product' and template.suffix == 'event'
              assign crumbs_overlay = true
            endif
          -%}
          <div class="od-crumbs-wrap{% if crumbs_overlay %} od-crumbs-wrap--overlay{% endif %}"><div class="_container_1kxnl_30">{% render 'breadcrumbs' %}</div></div>
        {%- endunless -%}
        {{ content_for_layout }}
        <div data-od-toaster style="position: fixed; z-index: 9999; inset: 16px; pointer-events: none;"></div>
      </main>
      {%- sections 'footer-group' -%}
      <button type="button" aria-label="{{ 'general.accessibility.back_to_top' | t }}" class="_backToTop_wlu9t_30" data-back-to-top>
        <svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 24 24" height="20" width="20" xmlns="http://www.w3.org/2000/svg"><path fill="none" d="M0 0h24v24H0V0z"></path><path d="m4 12 1.41 1.41L11 7.83V20h2V7.83l5.58 5.59L20 12l-8-8-8 8z"></path></svg>
      </button>
    </div>
    <div id="modal">
      {%- render 'modal-search' -%}
      {%- render 'modal-login' -%}
      {%- render 'modal-language' -%}
      {%- unless settings.size_guide_enabled == false -%}{%- render 'modal-size-guide' -%}{%- endunless -%}
      {%- render 'modal-mobile-submenus' -%}
      {%- section 'cart-drawer' -%}
      {%- render 'quick-add-drawer' -%}
      {%- render 'wishlist-drawer' -%}
      {%- section 'welcome-popup' -%}
      {%- if request.page_type == 'collection' or request.page_type == 'search' -%}
        {%- section 'od-filter' -%}
      {%- endif -%}
    </div>
    <script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>
    {%- if settings.notify_mode != 'off' and settings.notify_endpoint != blank -%}<script src="{{ 'od-notify.js' | asset_url }}" defer></script>{%- endif %}
    {%- unless settings.size_guide_enabled == false %}<script src="{{ 'od-size.js' | asset_url }}" defer></script>{%- endunless %}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    {%- unless settings.cur_enabled == false %}<script src="{{ 'od-currency.js' | asset_url }}" defer></script>{%- endunless %}
    <script src="{{ 'od-card.js' | asset_url }}" defer></script>
    <script src="{{ 'od-cart.js' | asset_url }}" defer></script>
    <script src="{{ 'od-menu.js' | asset_url }}" defer></script>
    <script src="{{ 'od-listing.js' | asset_url }}" defer></script>
    <script src="{{ 'od-blocks.js' | asset_url }}" defer></script>
  </body>
</html>
